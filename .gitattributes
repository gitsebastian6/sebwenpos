# ---------------------------------------------------------------------------
# SebwenPOS — Git Attributes
# ---------------------------------------------------------------------------
# Enforce LF line endings for shell scripts to prevent CRLF issues in Docker.
# Windows users: Git will auto-convert CRLF on checkout but these files will
# always be committed with LF, preventing "no such file or directory" errors
# when Docker copies them into Linux containers.
# ---------------------------------------------------------------------------

# Shell scripts MUST always use LF (Linux line endings) — never CRLF
*.sh text eol=lf

# Husky hooks run via `sh` — CRLF rompe el shebang / los comandos en Linux/CI
.husky/* text eol=lf

# Node.js files prefer LF
*.js text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf

# Web files
*.html text eol=lf
*.css text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Config files
.env.* text eol=lf

# Prisma migrations — LF only. Prisma checksums the file content; a CRLF
# checkout would make `migrate deploy` reject an already-applied migration.
*.sql text eol=lf
prisma/migrations/**/*.sql text eol=lf
prisma/migrations/migration_lock.toml text eol=lf
Dockerfile text eol=lf
docker-compose*.yml text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# Binary files (no normalization)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.p12 binary
*.pfx binary
*.db binary
*.sqlite binary
*.sqlite3 binary
