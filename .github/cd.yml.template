# ---------------------------------------------------------------------------
# VentifyPOS — CD Pipeline (Phase 4B — Continuous Deployment)
# ---------------------------------------------------------------------------
# ⚠️  IMPORTANT: This file must be placed at .github/workflows/cd.yml
#     The PAT used for deployment doesn't have 'workflow' scope, so this
#     file needs to be added via the GitHub web UI or a PAT with workflow scope.
#
# To add this file:
#   1. Go to: https://github.com/gitsebastian6/ventifypos/new/main
#   2. Name the file: .github/workflows/cd.yml
#   3. Paste this content
#   4. Click "Commit changes"
#
# OR use a PAT with workflow scope:
#   1. Create PAT at https://github.com/settings/tokens with 'workflow' scope
#   2. git remote set-url origin https://<PAT>@github.com/gitsebastian6/ventifypos.git
#   3. git push origin main
# ---------------------------------------------------------------------------
# Pipeline overview:
#   1. Verify CI passed (only deploys after successful CI)
#   2. Build production Docker image
#   3. Push to GitHub Container Registry (ghcr.io)
#   4. Create GitHub deployment status
#   5. Deploy to VPS via SSH (optional, needs DEPLOY_* secrets)
# ---------------------------------------------------------------------------
# Required GitHub Secrets (for VPS deployment):
#   DEPLOY_HOST     - VPS hostname/IP
#   DEPLOY_USER     - SSH user (default: root)
#   DEPLOY_SSH_KEY  - Private SSH key
#   DEPLOY_PORT     - SSH port (default: 22)
# ---------------------------------------------------------------------------

name: CD

on:
  workflow_run:
    workflows: ["CI"]
    types: [completed]
    branches: [main, master]

  workflow_dispatch:
    inputs:
      deploy_to_server:
        description: "Deploy to VPS server?"
        required: false
        default: "false"
        type: boolean

concurrency:
  group: cd-${{ github.ref }}
  cancel-in-progress: false

permissions:
  contents: read
  packages: write
  deployments: write
  statuses: write

env:
  REGISTRY: ghcr.io
  IMAGE_NAME: ${{ github.repository }}

jobs:
  # ── Verify CI passed ────────────────────────────────────────────────────
  verify-ci:
    name: Verify CI Status
    runs-on: ubuntu-latest
    timeout-minutes: 5
    if: >
      github.event_name == 'workflow_dispatch' ||
      github.event.workflow_run.conclusion == 'success'
    steps:
      - name: CI Status Check
        run: |
          if [ "${{ github.event_name }}" = "workflow_run" ]; then
            echo "✅ CI completed: ${{ github.event.workflow_run.conclusion }}"
            if [ "${{ github.event.workflow_run.conclusion }}" != "success" ]; then
              echo "❌ CI failed. Aborting CD."
              exit 1
            fi
          else
            echo "🔄 Manual deployment triggered"
          fi

  # ── Build & Push Docker Image ──────────────────────────────────────────
  build-and-push:
    name: Build & Push Docker Image
    needs: verify-ci
    runs-on: ubuntu-latest
    timeout-minutes: 20

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Docker metadata
        id: meta
        uses: docker/metadata-action@v5
        with:
          images: ${{ env.REGISTRY }}/${{ env.IMAGE_NAME }}
          tags: |
            type=ref,event=branch
            type=sha,prefix=
            type=raw,value=latest,enable={{is_default_branch}}
            type=semver,pattern={{version}}
            type=semver,pattern={{major}}.{{minor}}

      - name: Set up Docker Buildx
        uses: docker/setup-buildx-action@v3

      - name: Login to GitHub Container Registry
        uses: docker/login-action@v3
        with:
          registry: ${{ env.REGISTRY }}
          username: ${{ github.actor }}
          password: ${{ secrets.GITHUB_TOKEN }}

      - name: Build and push Docker image
        uses: docker/build-push-action@v6
        with:
          context: .
          file: ./Dockerfile
          push: true
          tags: ${{ steps.meta.outputs.tags }}
          labels: ${{ steps.meta.outputs.labels }}
          cache-from: type=gha
          cache-to: type=gha,mode=max
          build-args: |
            BUILDKIT_INLINE_CACHE=1

      - name: Image digest
        run: |
          echo "## 🐳 Docker Image Published" >> $GITHUB_STEP_SUMMARY
          echo "" >> $GITHUB_STEP_SUMMARY
          echo "**Image:** \`${{ env.REGISTRY }}/${{ env.IMAGE_NAME }}\`" >> $GITHUB_STEP_SUMMARY
          echo "**Tags:** \`${{ steps.meta.outputs.tags }}\`" >> $GITHUB_STEP_SUMMARY
          echo "**Digest:** \`${{ steps.meta.outputs.digest }}\`" >> $GITHUB_STEP_SUMMARY
          echo "**SHA:** \`${{ github.sha }}\`" >> $GITHUB_STEP_SUMMARY

  # ── Create Deployment Status ───────────────────────────────────────────
  create-deployment:
    name: Create Deployment Status
    needs: build-and-push
    runs-on: ubuntu-latest
    timeout-minutes: 5
    if: always()

    steps:
      - name: Create deployment status
        uses: actions/github-script@v7
        with:
          script: |
            const success = '${{ needs.build-and-push.result }}' === 'success';

            await github.rest.repos.createCommitStatus({
              owner: context.repo.owner,
              repo: context.repo.repo,
              sha: context.sha,
              state: success ? 'success' : 'failure',
              target_url: `https://github.com/${context.repo.owner}/${context.repo.repo}/actions/runs/${context.runId}`,
              description: success ? 'Docker image published to ghcr.io' : 'Docker build/push failed',
              context: 'CD / Deploy'
            });

            console.log(`✅ Deployment status: ${success ? 'SUCCESS' : 'FAILURE'}`);

  # ── Deploy to VPS (Optional) ───────────────────────────────────────────
  deploy-vps:
    name: Deploy to VPS
    needs: build-and-push
    runs-on: ubuntu-latest
    timeout-minutes: 10
    if: >
      (github.event_name == 'workflow_dispatch' && github.event.inputs.deploy_to_server == 'true') ||
      (github.event_name == 'workflow_run' && secrets.DEPLOY_HOST != '')

    environment:
      name: production
      url: ${{ vars.APP_URL || 'https://ventifypos.com' }}

    steps:
      - name: Setup SSH key
        run: |
          mkdir -p ~/.ssh
          echo "${{ secrets.DEPLOY_SSH_KEY }}" > ~/.ssh/deploy_key
          chmod 600 ~/.ssh/deploy_key
          ssh-keyscan -p ${{ secrets.DEPLOY_PORT || 22 }} -H ${{ secrets.DEPLOY_HOST }} >> ~/.ssh/known_hosts 2>/dev/null || true

      - name: Deploy to server
        env:
          DEPLOY_HOST: ${{ secrets.DEPLOY_HOST }}
          DEPLOY_USER: ${{ secrets.DEPLOY_USER || 'root' }}
          DEPLOY_PORT: ${{ secrets.DEPLOY_PORT || 22 }}
          IMAGE_TAG: ${{ github.sha }}
          REGISTRY: ${{ env.REGISTRY }}
          IMAGE_NAME: ${{ env.IMAGE_NAME }}
        run: |
          ssh -i ~/.ssh/deploy_key -p $DEPLOY_PORT $DEPLOY_USER@$DEPLOY_HOST << DEPLOY_SCRIPT
          set -e
          echo "🚀 Deploying VentifyPOS..."
          docker pull ${REGISTRY}/${IMAGE_NAME}:${IMAGE_TAG}
          docker tag ${REGISTRY}/${IMAGE_NAME}:${IMAGE_TAG} ${REGISTRY}/${IMAGE_NAME}:latest
          docker stop ventifypos 2>/dev/null || true
          docker rm ventifypos 2>/dev/null || true
          docker run -d \
            --name ventifypos \
            --restart unless-stopped \
            -p 3000:3000 \
            -v ventifypos-data:/app/db \
            --env-file /opt/ventifypos/.env \
            ${REGISTRY}/${IMAGE_NAME}:${IMAGE_TAG}
          sleep 10
          if curl -sf http://localhost:3000/api/health > /dev/null 2>&1; then
            echo "✅ Deployment successful!"
          else
            docker logs ventifypos --tail 50
            exit 1
          fi
          docker image prune -f --filter "until=72h"
          DEPLOY_SCRIPT

      - name: Cleanup
        if: always()
        run: rm -rf ~/.ssh/deploy_key
