# =============================================================================
# Ventify POS — Environment Variables Template
# =============================================================================
# Copy this file as `.env` and fill in the values for your environment.
# NEVER commit your actual `.env` file to version control.
# Generate random secrets with: openssl rand -base64 32
# =============================================================================

# ─── Core Application ────────────────────────────────────────────────────────

# Database URL (SQLite file path or PostgreSQL connection string)
DATABASE_URL="file:/home/z/my-project/db/custom.db"

# Secret for signing auth tokens and encrypting sensitive fields.
# REQUIRED. Generate: openssl rand -base64 32
AUTH_SECRET=""

# Secret for internal API-to-API communication (webhook verification, alerts).
# REQUIRED if using subscription alerts. Generate: openssl rand -base64 32
INTERNAL_SECRET=""

# Encryption key for field-level encryption (cert passwords, software PINs).
# Falls back to AUTH_SECRET if not set, but RECOMMENDED for production.
# Generate: openssl rand -base64 32
ENCRYPTION_KEY=""

# Public URL of the application (used for DIAN callbacks, email links, QR codes)
NEXT_PUBLIC_APP_URL="https://your-domain.com"

# Node environment (development | production)
NODE_ENV="production"

# ─── Sentry — Error Monitoring ──────────────────────────────────────────────

# Sentry DSN for error tracking. Get yours at https://sentry.io/settings/projects/
# If empty, Sentry is DISABLED (no errors sent, no performance impact)
NEXT_PUBLIC_SENTRY_DSN=""

# Optional: Override auto-detected release version
# NEXT_PUBLIC_SENTRY_RELEASE="ventify@1.0.0"

# ─── DIAN — Factura Electrónica Colombia ─────────────────────────────────────

# Software provider NIT registered with DIAN
DIAN_SOFTWARE_PROVIDER_NIT=""

# Software name registered with DIAN
DIAN_SOFTWARE_NAME="Ventify POS"

# Software PIN assigned by DIAN
DIAN_SOFTWARE_PIN=""

# Certificate password (if using file-based certs instead of DB upload)
DIAN_CERT_PASSWORD=""

# ─── SMTP — Email Configuration ──────────────────────────────────────────────

# SMTP server for sending invoices and notifications by email
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="facturacion@your-domain.com"
SMTP_FROM_NAME="Ventify POS Facturación"

# ─── MessageBird — WhatsApp OTP ──────────────────────────────────────────────

# MessageBird API key for WhatsApp OTP (password recovery)
MESSAGEBIRD_API_KEY=""

# Phone number to send OTP from (must be verified in MessageBird)
MESSAGEBIRD_PHONE=""

# WhatsApp message template ID (MessageBird HSM template)
MESSAGEBIRD_TEMPLATE_ID=""

# ─── Support ─────────────────────────────────────────────────────────────────

# Support phone number displayed in login page
SUPPORT_PHONE=""

# ─── Super Admin Seed (Development Only) ─────────────────────────────────────

# Allow seeding the database via /api/seed (NEVER enable in production)
ALLOW_SEED="false"
