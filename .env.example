# =============================================================================
# Ventify POS — Environment Variables Template
# =============================================================================
# Copy this file as `.env` and fill in the values for your environment.
# NEVER commit your actual `.env` file to version control.
# Generate random secrets with: openssl rand -base64 32
# =============================================================================

# ─── Core Application ────────────────────────────────────────────────────────

# Database URL (SQLite file path or PostgreSQL connection string)
DATABASE_URL="file:/home/z/my-project/db/custom.db"

# Secret for signing auth tokens and encrypting sensitive fields.
# REQUIRED. Generate: openssl rand -base64 32
AUTH_SECRET=""

# Secret for internal API-to-API communication (webhook verification, alerts).
# REQUIRED if using subscription alerts. Generate: openssl rand -base64 32
INTERNAL_SECRET=""

# Encryption key for field-level encryption (cert passwords, software PINs).
# Falls back to AUTH_SECRET if not set, but RECOMMENDED for production.
# Generate: openssl rand -base64 32
ENCRYPTION_KEY=""

# Public URL of the application (used for DIAN callbacks, email links, QR codes)
NEXT_PUBLIC_APP_URL="https://your-domain.com"

# Node environment (development | production)
NODE_ENV="production"

# ─── Sentry — Error Monitoring ──────────────────────────────────────────────

# Sentry DSN for error tracking. Get yours at https://sentry.io/settings/projects/
# If empty, Sentry is DISABLED (no errors sent, no performance impact)
NEXT_PUBLIC_SENTRY_DSN=""

# Optional: Override auto-detected release version
# NEXT_PUBLIC_SENTRY_RELEASE="ventify@1.0.0"

# ─── DIAN — Factura Electrónica Colombia ─────────────────────────────────────

# Software provider NIT registered with DIAN
DIAN_SOFTWARE_PROVIDER_NIT=""

# Software name registered with DIAN
DIAN_SOFTWARE_NAME="Ventify POS"

# Software PIN assigned by DIAN
DIAN_SOFTWARE_PIN=""

# Certificate password (if using file-based certs instead of DB upload)
DIAN_CERT_PASSWORD=""

# ─── SMTP — Email Configuration ──────────────────────────────────────────────

# SMTP server for sending invoices and notifications by email
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="facturacion@your-domain.com"
SMTP_FROM_NAME="Ventify POS Facturación"

# ─── MessageBird — WhatsApp OTP ──────────────────────────────────────────────

# MessageBird API key for WhatsApp OTP (password recovery)
MESSAGEBIRD_API_KEY=""

# Phone number to send OTP from (must be verified in MessageBird)
MESSAGEBIRD_PHONE=""

# WhatsApp message template ID (MessageBird HSM template)
MESSAGEBIRD_TEMPLATE_ID=""

# ─── Wompi — Payment Gateway (Colombia) ─────────────────────────────────────
#
# TRES MODOS DE OPERACIÓN:
#
# 1. "demo"       → No necesita llaves. Simula pagos que se auto-aprueban.
#                    Perfecto para desarrollo y pruebas sin cuenta Wompi.
#                    Cambiar a "sandbox" o "production" cuando tengas llaves reales.
#
# 2. "sandbox"    → Usa las llaves de prueba de Wompi (pub_test_... / prv_test_...).
#                    Requiere cuenta en https://dashboard.wompi.co
#                    Las transacciones son de prueba, no cobran dinero real.
#
# 3. "production" → Usa las llaves de producción (pub_prod_... / prv_prod_...).
#                    Las transacciones son REALES y cobran dinero.
#                    Requiere verificación KYC completa en Wompi.
#
# IMPORTANTE: El cambio entre modos SOLO requiere cambiar WOMPI_ENV y las llaves.
# Todo el código de negocio (validaciones, BD, facturación) es idéntico en los 3 modos.

# Wompi environment: "demo" | "sandbox" | "production"
WOMPI_ENV="demo"

# Wompi public key (for server-side API calls). Get yours at https://dashboard.wompi.co
# NOT required in demo mode. Required for sandbox/production.
WOMPI_PUBLIC_KEY=""

# Wompi private key (for server-side API calls). NEVER expose this to the browser.
# NOT required in demo mode. Required for sandbox/production.
WOMPI_PRIVATE_KEY=""

# Wompi webhook secret (for verifying webhook signatures from Wompi)
# NOT required in demo mode. Required for sandbox/production.
WOMPI_WEBHOOK_SECRET=""

# Wompi public key for browser (Wompi Widget / embedded checkout)
# Required only if using the Wompi Widget instead of payment links
NEXT_PUBLIC_WOMPI_PUBLIC_KEY=""

# Skip webhook signature verification in sandbox (ONLY for development convenience)
# Default: "false" — signature is always verified unless explicitly set to "true"
# In production and demo mode, this flag is IGNORED
WOMPI_SKIP_SIGNATURE="false"

# ─── Support ─────────────────────────────────────────────────────────────────

# Support phone number displayed in login page
SUPPORT_PHONE=""

# ─── Super Admin Seed (Development Only) ─────────────────────────────────────

# Allow seeding the database via /api/seed (NEVER enable in production)
ALLOW_SEED="false"
