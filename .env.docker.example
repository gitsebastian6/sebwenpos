# ---------------------------------------------------------------------------
# SebwenPOS — Docker Environment Variables (TEMPLATE)
# ---------------------------------------------------------------------------
# Copy this file and fill in real values before running docker compose:
#   cp .env.docker.example .env.docker
#   docker compose --env-file .env.docker up --build
#
# The real .env.docker is git-ignored. NEVER commit real secrets.
# Generate random secrets with: openssl rand -base64 32
# ---------------------------------------------------------------------------

# ── PostgreSQL ───────────────────────────────────────────────────────────
POSTGRES_PASSWORD=CHANGE_ME_postgres_password

# ── Auth (REQUIRED — compose refuses to start without these) ─────────────
AUTH_SECRET=CHANGE_ME_openssl_rand_base64_32
INTERNAL_SECRET=CHANGE_ME_openssl_rand_base64_32

# ── App URL ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Field encryption (RECOMMENDED — distinct from AUTH_SECRET) ──────────
ENCRYPTION_KEY=CHANGE_ME_openssl_rand_base64_32

# ── Email (configure for production) ────────────────────────────────────
SMTP_FROM=noreply@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# ── Alerts ───────────────────────────────────────────────────────────────
ALERT_API_BASE=http://localhost:3010

# ── Wompi — Payment Gateway ─────────────────────────────────────────────
# Modos: "demo" (sin llaves, auto-aprueba) | "sandbox" (pruebas) | "production" (real)
# En demo NO necesitas llaves, los pagos se simulan y aprueban automáticamente.
# Para sandbox/production obtén tus llaves en https://dashboard.wompi.co
# ⚠️ NUNCA "demo" en producción: con NODE_ENV=production la app aborta el
#    arranque si WOMPI_ENV=demo (o si falta) — evita cobros "aprobados" sin dinero.
WOMPI_ENV=sandbox
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_WEBHOOK_SECRET=
NEXT_PUBLIC_WOMPI_PUBLIC_KEY=

# ── Super Admin (seeds on first run) ────────────────────────────────────
# Opcional: configura para crear el super admin automáticamente en el primer inicio
# SUPERADMIN_CEDULA=1234567890
# SUPERADMIN_PASSWORD=CHANGE_ME_strong_password
# SUPERADMIN_NAME=Super Administrador

# ── pgAdmin (optional, for database GUI) ─────────────────────────────────
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=CHANGE_ME_pgadmin_password

# ── AI Chat (asistente virtual) ──────────────────────────────────────────
# Proveedor principal: Google AI Studio (Gemini). Consigue tu llave gratis en:
# https://aistudio.google.com/apikey
# Si la dejas vacía, el chat usa Z.ai/ZhipuAI (si están configurados) o
# respuestas predefinidas como último recurso.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
