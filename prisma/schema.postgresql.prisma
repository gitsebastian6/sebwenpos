generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


// ----------------------------------------------
// CONTEXTO: IDENTIDAD Y ACCESO
// ----------------------------------------------

model User {
  id           Int      @id @default(autoincrement())
  cedula       String   @unique // Numero de identificacion / cedula (login)
  phone        String?  // Telefono de contacto
  email        String?
  passwordHash String
  fullName     String?  @map("full_name")
  role         String   @default("OWNER") // SUPER_ADMIN, OWNER, EMPLOYEE
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt

  store    Store?    @relation("UserStore")
  employee Employee? @relation("EmployeeStore")

  cashRegisters CashRegister[]

  @@map("users")
}

model Store {
  id           Int      @id @default(autoincrement())
  userId       Int      @unique @map("user_id")
  name         String
  legalName    String?  @map("legal_name") // Razon social / nombre legal
  nit          String?  // Numero de Identificacion Tributaria
  address      String?  // Direccion del negocio
  phone        String?  // Telefono del negocio
  currencyCode String   @default("COP") @map("currency_code")
  countryCode  String?  @map("country_code")
  // DIAN Resolution (Facturación Electrónica)
  invoicePrefix          String?  @map("invoice_prefix") // Prefijo: FE, POS
  resolutionNumber       String?  @map("resolution_number") // Número de resolución DIAN: 18764
  resolutionStartDate    DateTime? @map("resolution_start_date") // Fecha inicio rango numeración
  resolutionEndDate      DateTime? @map("resolution_end_date") // Fecha fin rango numeración
  resolutionStartNumber  Int?     @map("resolution_start_number") // Consecutivo inicial
  resolutionEndNumber    Int?     @map("resolution_end_number") // Consecutivo final
  invoiceTestMode        Boolean  @default(true) @map("invoice_test_mode") // true=habilitación, false=producción
  // Facturación Electrónica Híbrida
  invoiceProvider        String   @default("NONE") @map("invoice_provider") // NONE, DIAN_DIRECT, SIMBA, ALEGRA, CUBI, SIIGO, HOLDING
  invoiceEnabled         Boolean  @default(false) @map("invoice_enabled") // Activar/desactivar facturación electrónica
  certificateUploaded    Boolean  @default(false) @map("certificate_uploaded") // Si se subió certificado .p12
  certificatePassword    String?  @map("certificate_password") // Contraseña del certificado .p12
  softwareId             String?  @map("software_id") // Software ID registrado en DIAN (identificación del software)
  softwarePin            String?  @map("software_pin") // PIN del software (6 dígitos)
  providerConfig         String   @default("{}") @map("provider_config") @db.Text // JSON: {simba:{apiKey,accountId},alegra:{token,apiUrl},...}
  // DIVIPOLA (código municipio DIAN) — para XML electrónico
  divipolaCode           String?  @map("divipola_code")   // Código DIVIPOLA del municipio: "11001" Bogotá, "05001" Medellín, etc.
  cityName               String?  @map("city_name")       // Nombre del municipio: "Bogotá D.C.", "Medellín", etc.
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt

  user                User                 @relation("UserStore", fields: [userId], references: [id])
  employees           Employee[]
  roles               Role[]
  categories          Category[]
  products            Product[]
  inventoryMovements  InventoryMovement[]
  customers           Customer[]
  orders              Order[]
  ledgerAccounts      LedgerAccount[]
  journalEntries      JournalEntry[]
  services            Service[]
  serviceTransactions ServiceTransaction[]
  barTables           BarTable[]
  tableSessions       TableSession[]
  comandaItems        ComandaItem[]
  providers           Provider[]
  purchases           Purchase[]
  cashRegisters       CashRegister[]
  expenses            Expense[]
  taxRates            TaxRate[]
  invoices            Invoice[]
  creditNotes         CreditNote[]
  contingencyInvoices ContingencyInvoice[]
  quotations          Quotation[]
  subscription        Subscription?
  paymentReceipts     PaymentReceipt[]

  @@map("stores")
}

// ----------------------------------------------
// CONTEXTO: PLANES Y SUSCRIPCIONES (SaaS)
// ----------------------------------------------

model Plan {
  id          Int      @id @default(autoincrement())
  name        String   // Nombre del plan: Trial, Básico, Pro, Empresarial
  description String?  // Descripción del plan
  price       Int      // Precio en COP por mes (0 para trial/gratis)
  // Límites del plan (solo recursos, NO operaciones)
  maxStores         Int @default(1) @map("max_stores")         // Tiendas permitidas
  maxEmployees      Int @default(5) @map("max_employees")      // Empleados por tienda (-1 = ilimitado)
  maxProducts       Int @default(100) @map("max_products")      // Productos por tienda (-1 = ilimitado)
  // Features (JSON): {"electronicInvoicing": true, "multiStore": false, "api": false, "support": "email", ...}
  features    String   @default("{}") @map("features") @db.Text
  sortOrder   Int      @default(0) @map("sort_order")          // Orden de visualización
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt

  subscriptions Subscription[]

  @@unique([name])
  @@map("plans")
}

model Subscription {
  id             Int       @id @default(autoincrement())
  storeId        Int       @unique @map("store_id")
  planId         Int       @map("plan_id")
  status         String    @default("TRIAL") // TRIAL, ACTIVE, PAST_DUE, CANCELLED, EXPIRED
  startDate      DateTime  @default(now()) @map("start_date")
  endDate        DateTime? @map("end_date")   // Null = indefinido (planes anuales renovables)
  trialEndDate   DateTime? @map("trial_end_date") // Fecha fin del trial
  cancelReason   String?   @map("cancel_reason")
  // Facturación del plan
  billingPeriod  String    @default("MONTHLY") @map("billing_period") // TRIAL, MONTHLY, QUARTERLY, SEMI_ANNUAL, ANNUAL
  billingPrice   Int       // Precio pagado al momento de la suscripción (snapshot)
  lastBilledAt   DateTime? @map("last_billed_at")
  nextBillingAt  DateTime? @map("next_billing_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt

  store            Store             @relation(fields: [storeId], references: [id])
  plan            Plan              @relation(fields: [planId], references: [id])
  paymentReceipts PaymentReceipt[]

  @@map("subscriptions")
}

// ----------------------------------------------
// CONTEXTO: COMPROBANTES DE PAGO
// ----------------------------------------------

model PaymentReceipt {
  id             Int       @id @default(autoincrement())
  subscriptionId Int       @map("subscription_id")
  storeId        Int       @map("store_id")
  // Archivo del comprobante
  fileName       String    @map("file_name")     // Nombre original del archivo
  fileSize       Int       @map("file_size")     // Tamaño en bytes
  fileType       String    @map("file_type")     // MIME type: image/png, image/jpeg, application/pdf
  fileData       String    @map("file_data") @db.Text // Base64 encoded
  // Monto reportado por el cliente
  amount         Int       // Monto del pago en COP
  reference      String?   // Referencia del pago (número de transacción, consignación, etc.)
  paymentMethod  String    @default("OTHER") @map("payment_method") // NEQUI, DAVIPLATA, BANCOLOMBIA, BANCARY, EFFECTIVE, OTHER
  notes          String?   @db.Text // Notas adicionales del cliente
  // Estado de revisión
  status         String    @default("PENDING") // PENDING, APPROVED, REJECTED
  reviewedBy     String?   @map("reviewed_by") // "SUPER_ADMIN"
  reviewNotes    String?   @map("review_notes") @db.Text // Razón de aprobación/rechazo
  reviewedAt     DateTime? @map("reviewed_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  store        Store        @relation(fields: [storeId], references: [id])

  @@map("payment_receipts")
}

// ----------------------------------------------
// CONTEXTO: IMPUESTOS Y TRIBUTACION (DIAN)
// ----------------------------------------------

model TaxRate {
  id          Int      @id @default(autoincrement())
  storeId     Int      @map("store_id")
  name        String   // Nombre descriptivo: "IVA 19%", "IVA 5%", "Impoconsumo 8%"
  code        String   // Codigo DIAN: "01"=IVA 19%, "02"=IVA 5%, "03"=IVA 0% Exento, "04"=IVA Excluido, "05"=Impoconsumo
  rateType    String   @map("rate_type") // PERCENTAGE, FIXED_AMOUNT
  rate        Int      // Tasa: 19 para 19%, 800 para $800 fijos
  applyTo     String   @default("PRODUCT") // PRODUCT, SERVICE, BOTH
  category    String   @default("SALES_TAX") // SALES_TAX, CONSUMPTION_TAX, WITHHOLDING, MUNICIPAL
  isActive    Boolean  @default(true) @map("is_active")
  isDefault   Boolean  @default(false) @map("is_default") // Tasa por defecto para nuevos productos
  description String?  // Descripcion detallada o nota legal
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt

  store     Store     @relation(fields: [storeId], references: [id])
  products  Product[]

  @@unique([storeId, code])
  @@map("tax_rates")
}

// ----------------------------------------------
// CONTEXTO: FACTURACION ELECTRONICA (DIAN)
// ----------------------------------------------

model Invoice {
  id              Int      @id @default(autoincrement())
  storeId         Int      @map("store_id")
  orderId         Int      @unique @map("order_id")
  // Numeracion DIAN
  prefix          String   @default("FE") // Prefijo de la resolucion: FE, POS
  consecutive     Int      // Numero consecutivo dentro del rango autorizado
  resolutionNumber String? @map("resolution_number") // Numero de resolucion DIAN: 18764
  resolutionDate  DateTime? @map("resolution_date") // Fecha de la resolucion
  startDate       DateTime? @map("start_date") // Fecha inicio rango de numeracion
  endDate         DateTime? @map("end_date") // Fecha fin rango de numeracion
  startNumber     Int?     @map("start_number") // Consecutivo inicial autorizado
  endNumber       Int?     @map("end_number") // Consecutivo final autorizado
  // Informacion del cliente
  customerNit     String?  @map("customer_nit") // NIT del cliente (DIAN requires 13 digits or 222222222222 for consumer)
  customerName    String?  @map("customer_name") // Nombre / razon social del cliente
  customerAddress String?  @map("customer_address") // Direccion del cliente
  customerPhone   String?  @map("customer_phone") // Telefono del cliente
  customerEmail   String?  @map("customer_email") // Email del cliente
  customerRegime  String?  @map("customer_regime") // Regimen fiscal: RESPONSABLE, NO_RESPONSABLE, SIMPLIFICADO
  customerType    String?  @map("customer_type") // Tipo de documento: CC, NIT, CE, TI, PP
  // Desglose tributario
  subtotalBase    Int      @map("subtotal_base") // Base gravable (antes de impuestos)
  taxExemptAmount Int      @default(0) @map("tax_exempt_amount") // Monto exento de impuestos
  taxBreakdown    String?  @map("tax_breakdown") @db.Text // JSON: [{code:"01",name:"IVA 19%",base:50000,rate:19,amount:9500}]
  totalTaxAmount  Int      @default(0) @map("total_tax_amount") // Suma total de impuestos
  totalWithTax    Int      @map("total_with_tax") // Total con impuestos
  discountAmount  Int      @default(0) @map("discount_amount") // Descuento total
  tipAmount       Int      @default(0) @map("tip_amount") // Propina
  grandTotal      Int      @map("grand_total") // Total final (totalWithTax - discount + tip)
  paymentMethod   String?  @map("payment_method") // Metodo de pago DIAN: 1=EFECTIVO, 2=BANCO, etc.
  paymentNotes    String?  @map("payment_notes") // Notas de pago
  // DIAN Compliance
  cufe            String?  // Codigo Unico de Factura Electronica (CUFE/CUDFE)
  qrCode          String?  @map("qr_code") // URL del codigo QR con CUFE
  xmlContent      String?  @map("xml_content") @db.Text // XML UBL 2.1 generado
  notes           String?  @db.Text // Notas/observaciones
  // Estado
  status          String   @default("DRAFT") // DRAFT, PENDING_VALIDATE, VALIDATED, DELIVERED, REJECTED, CANCELLED
  dianResponse    String?  @map("dian_response") @db.Text // JSON: respuesta de la DIAN al validar
  dianErrorCode   String?  @map("dian_error_code") // Codigo de error DIAN si fue rechazada
  sentAt          DateTime? @map("sent_at") // Fecha/hora de envio a DIAN
  validatedAt     DateTime? @map("validated_at") // Fecha/hora de validacion exitosa
  emailedAt       DateTime? @map("emailed_at") // Fecha/hora de envio por email al cliente
  // Ambiente
  testMode        Boolean  @default(true) @map("test_mode") // true=habilitacion, false=produccion
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id])
  order Order @relation(fields: [orderId], references: [id])

  creditNotes         CreditNote[]
  contingencyInvoices ContingencyInvoice[]

  @@map("invoices")
}

model CreditNote {
  id                Int       @id @default(autoincrement())
  storeId           Int       @map("store_id")
  invoiceId         Int?      @map("invoice_id")  // Factura original relacionada (si aplica)
  // Numeración DIAN
  prefix            String    @default("NC")
  consecutive       Int
  resolutionNumber  String?   @map("resolution_number")
  resolutionDate    DateTime? @map("resolution_date")
  startDate         DateTime? @map("start_date")
  endDate           DateTime? @map("end_date")
  startNumber       Int?      @map("start_number")
  endNumber         Int?      @map("end_number")
  // Tipo: 91=Nota Crédito, 92=Nota Débito
  noteType          String    @default("CREDIT")  // CREDIT or DEBIT
  // Concepto de la nota: "Devolución parcial", "Descuento", "Anulación", "Bonificación"
  concept           String    @map("concept")
  // Descripción detallada / motivo
  description       String?
  // Cliente
  customerNit       String?   @map("customer_nit")
  customerName      String?   @map("customer_name")
  customerEmail     String?   @map("customer_email")
  customerPhone     String?   @map("customer_phone")
  customerAddress   String?   @map("customer_address")
  customerRegime    String?   @map("customer_regime")
  customerType      String?   @map("customer_type")
  // Montos (pueden ser negativos para notas crédito)
  subtotalBase      Int       @default(0) @map("subtotal_base")
  taxExemptAmount   Int       @default(0) @map("tax_exempt_amount")
  taxBreakdown      String?   @map("tax_breakdown") @db.Text // JSON
  totalTaxAmount    Int       @default(0) @map("total_tax_amount")
  totalWithTax      Int       @map("total_with_tax")
  discountAmount    Int       @default(0) @map("discount_amount")
  grandTotal        Int       @map("grand_total")
  // DIAN
  cufe              String?   // CUDFE
  qrCode            String?   @map("qr_code")
  xmlContent        String?   @map("xml_content") @db.Text
  // Código de la factura relacionada (para DIAN)
  referencedInvoiceId String?  @map("referenced_invoice_id") // Número FE de la factura original
  referencedPrefix   String?  @map("referenced_prefix")
  referencedConsec   Int?     @map("referenced_consec")
  // Estado y envío
  status            String    @default("DRAFT")  // DRAFT, PENDING_VALIDATE, VALIDATED, REJECTED
  dianResponse      String?   @map("dian_response") @db.Text
  sentAt            DateTime? @map("sent_at")
  validatedAt       DateTime? @map("validated_at")
  emailedAt         DateTime? @map("emailed_at")
  testMode          Boolean   @default(true) @map("test_mode")
  notes             String?   @db.Text
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt

  store    Store    @relation(fields: [storeId], references: [id])
  invoice  Invoice? @relation(fields: [invoiceId], references: [id])

  @@map("credit_notes")
}

model ContingencyInvoice {
  id                Int       @id @default(autoincrement())
  storeId           Int       @map("store_id")
  invoiceId         Int?      @map("invoice_id")  // Factura original si la hay
  // Numeración de contingencia
  prefix            String    @default("FC")
  consecutive       Int
  // Tipo de contingencia: "03"=Contingencia facturador, "04"=Contingencia DIAN
  contingencyType   String    @default("04")  // "03" or "04"
  // Motivo de la contingencia
  reason            String?
  // Cliente
  customerNit       String?   @map("customer_nit")
  customerName      String?   @map("customer_name")
  customerEmail     String?   @map("customer_email")
  customerPhone     String?   @map("customer_phone")
  customerAddress   String?   @map("customer_address")
  customerRegime    String?   @map("customer_regime")
  customerType      String?   @map("customer_type")
  // Montos (iguales a la factura original)
  subtotalBase      Int       @default(0) @map("subtotal_base")
  taxExemptAmount   Int       @default(0) @map("tax_exempt_amount")
  taxBreakdown      String?   @map("tax_breakdown") @db.Text // JSON
  totalTaxAmount    Int       @default(0) @map("total_tax_amount")
  totalWithTax      Int       @map("total_with_tax")
  discountAmount    Int       @default(0) @map("discount_amount")
  grandTotal        Int       @map("grand_total")
  // Cufe de la factura original (se incluye para referencia)
  originalCufe      String?   @map("original_cufe")
  originalCufeQR    String?   @map("original_cufe_qr")
  // Código de la factura de contingencia (para DIAN)
  contingencyCufe   String?   @map("contingency_cufe")
  xmlContent        String?   @map("xml_content") @db.Text
  // Estado
  status            String    @default("DRAFT")  // DRAFT, PENDING_RETRANSMIT, RETRANSMITTED, REJECTED
  dianResponse      String?   @map("dian_response") @db.Text
  // Fechas de contingencia
  contingencyStart  DateTime  @default(now()) @map("contingency_start")
  contingencyEnd    DateTime? @map("contingency_end")
  // Cuando se retransmitió a DIAN (máx 48 horas después)
  retransmittedAt   DateTime? @map("retransmitted_at")
  testMode          Boolean   @default(true) @map("test_mode")
  notes             String?   @db.Text
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt

  store    Store    @relation(fields: [storeId], references: [id])
  invoice  Invoice? @relation(fields: [invoiceId], references: [id])

  @@map("contingency_invoices")
}

// ----------------------------------------------
// CONTEXTO: INVENTARIO Y CATALOGO
// ----------------------------------------------

model Category {
  id        Int      @id @default(autoincrement())
  storeId   Int      @map("store_id")
  name      String
  icon      String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt

  store    Store     @relation(fields: [storeId], references: [id])
  products Product[]

  @@unique([storeId, name])
  @@map("categories")
}

model Product {
  id            Int      @id @default(autoincrement())
  storeId       Int      @map("store_id")
  categoryId    Int?     @map("category_id")
  providerId    Int?     @map("provider_id")
  taxRateId     Int?     @map("tax_rate_id") // Clasificacion tributaria del producto
  sku           String?
  name          String
  description   String?
  imgUrl        String?  @map("img_url")
  invima        String?                                      // Registro INVIMA (opcional, Colombia)
  costPrice     Int      @default(0) @map("cost_price")       // en pesos colombianos
  salePrice     Int                                         // en pesos colombianos (incluye IVA si aplica)
  commission    Int      @default(0) @map("commission")   // porcentaje de comision (0-100)
  currentStock  Int      @default(0) @map("current_stock")
  minStock      Int      @default(5) @map("min_stock")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt

  store              Store                @relation(fields: [storeId], references: [id])
  category           Category?            @relation(fields: [categoryId], references: [id])
  provider           Provider?            @relation(fields: [providerId], references: [id])
  taxRate            TaxRate?             @relation(fields: [taxRateId], references: [id])
  inventoryMovements InventoryMovement[]
  orderItems         OrderItem[]
  comandaItems       ComandaItem[]
  purchaseItems      PurchaseItem[]
  quotationItems     QuotationItem[]

  @@unique([storeId, name])
  @@map("products")
}

model InventoryMovement {
  id           Int      @id @default(autoincrement())
  storeId      Int      @map("store_id")
  productId    Int      @map("product_id")
  quantity     Int      // positivo=entrada, negativo=salida
  movementType String   @map("movement_type") // PURCHASE, SALE, ADJUSTMENT, RETURN, LOSS
  referenceId  Int?     @map("reference_id")
  notes        String?
  createdAt    DateTime @default(now()) @map("created_at")

  store   Store   @relation(fields: [storeId], references: [id])
  product Product @relation(fields: [productId], references: [id])
  order   Order?  @relation("OrderMovements", fields: [referenceId], references: [id])

  @@map("inventory_movements")
}

model Purchase {
  id            Int      @id @default(autoincrement())
  storeId       Int      @map("store_id")
  providerId    Int?     @map("provider_id")
  invoiceNumber String?  @map("invoice_number") // Numero de factura del proveedor
  date          DateTime @default(now())
  notes         String?
  total         Int      @default(0) // total en pesos
  status        String   @default("COMPLETED") // COMPLETED, CANCELLED
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt

  store         Store          @relation(fields: [storeId], references: [id])
  provider      Provider?      @relation(fields: [providerId], references: [id])
  purchaseItems PurchaseItem[]

  @@map("purchases")
}

model PurchaseItem {
  id               Int @id @default(autoincrement())
  purchaseId       Int @map("purchase_id")
  productId        Int @map("product_id")
  quantity         Int
  returnedQuantity Int @default(0) @map("returned_quantity") // cantidad ya devuelta
  unitCost         Int @map("unit_cost") // costo unitario en pesos
  total            Int // quantity * unitCost

  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id])

  @@map("purchase_items")
}

model Provider {
  id          Int      @id @default(autoincrement())
  storeId     Int      @map("store_id")
  name        String
  contactName String?  @map("contact_name")
  phone       String?
  email       String?
  address     String?
  city        String?
  nit         String?  // Numero de Identificacion Tributaria
  notes       String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt

  store     Store      @relation(fields: [storeId], references: [id])
  products  Product[]
  purchases Purchase[]

  @@unique([storeId, name])
  @@map("providers")
}

// ----------------------------------------------
// CONTEXTO: VENTAS Y COMERCIO
// ----------------------------------------------

model Customer {
  id              Int      @id @default(autoincrement())
  storeId         Int      @map("store_id")
  name            String
  phone           String?
  email           String?
  nit             String?  // NIT o numero de identificacion tributaria
  documentType    String?  @map("document_type") // CC, NIT, CE, TI, PP
  address         String?  // Direccion del cliente
  regime          String?  // Regimen fiscal: RESPONSABLE, NO_RESPONSABLE, SIMPLIFICADO
  totalDebt       Int      @default(0) @map("total_debt") // en pesos
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt

  store          Store          @relation(fields: [storeId], references: [id])
  orders         Order[]
  tableSessions  TableSession[]
  quotations     Quotation[]

  @@map("customers")
}

model Order {
  id             Int            @id @default(autoincrement())
  storeId        Int            @map("store_id")
  customerId     Int?           @map("customer_id")
  tableSessionId Int?           @map("table_session_id")
  cashRegisterId Int?           @map("cash_register_id")
  orderNumber    String         @map("order_number")
  subtotal       Int            // pesos (solo productos/servicios, SIN impuestos)
  taxAmount      Int            @default(0) @map("tax_amount") // total impuestos
  taxBreakdown   String?        @map("tax_breakdown") @db.Text // JSON desglose por tipo de impuesto
  tipAmount      Int            @default(0) @map("tip_amount") // propina en pesos
  discountAmount Int            @default(0) @map("discount_amount") // descuento en pesos
  discountType   String         @default("NONE") @map("discount_type") // NONE, PERCENTAGE, FIXED
  discountReason String?        @map("discount_reason") // razon del descuento
  total          Int            // pesos (subtotal + taxAmount - discountAmount + tipAmount)
  status         String         @default("COMPLETED") // COMPLETED, PENDING, CANCELLED, CREDIT
  paymentMethod  String         @default("CASH") @map("payment_method") // CASH, DAVIPLATA, NEQUI, CARD, TRANSFER, MIXED, CREDIT
  notes          String?
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt

  store              Store               @relation(fields: [storeId], references: [id])
  customer           Customer?           @relation(fields: [customerId], references: [id])
  tableSession       TableSession?       @relation(fields: [tableSessionId], references: [id])
  cashRegister       CashRegister?       @relation(fields: [cashRegisterId], references: [id])
  orderItems         OrderItem[]
  inventoryMovements InventoryMovement[] @relation("OrderMovements")
  invoice            Invoice?

  @@map("orders")
}

model OrderItem {
  id               Int      @id @default(autoincrement())
  orderId          Int      @map("order_id")
  productId        Int?     @map("product_id")
  serviceId        Int?     @map("service_id")
  quantity         Int
  returnedQuantity Int      @default(0) @map("returned_quantity") // cantidad ya devuelta
  unitPrice        Int      @map("unit_price") // precio al momento de la venta
  totalRow         Int      @map("total_row")  // quantity * unitPrice
  taxCode          String?  @map("tax_code") // Codigo del impuesto aplicado (snapshot): "01", "02", "03", "04", "05"
  taxRate          Int      @default(0) @map("tax_rate") // Tasa del impuesto al momento de la venta (snapshot)
  taxAmount        Int      @default(0) @map("tax_amount") // Monto del impuesto para esta linea
  taxBase          Int      @default(0) @map("tax_base") // Base gravable para esta linea
  notes            String?  // notas del item (ej: "sin hielo", "doble")

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id])
  service Service? @relation(fields: [serviceId], references: [id])

  @@map("order_items")
}

// ----------------------------------------------
// CONTEXTO: MESAS Y COMANDAS (RESTAURANTE/BAR)
// ----------------------------------------------

model BarTable {
  id        Int      @id @default(autoincrement())
  storeId   Int      @map("store_id")
  number    Int      // numero de mesa
  name      String?  // nombre opcional (ej: "Terraza 1")
  capacity  Int      @default(4) // capacidad en personas
  zone      String   @default("PRINCIPAL") // PRINCIPAL, TERRAZA, VIP, BARRA, EXTERIOR
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt

  store          Store          @relation(fields: [storeId], references: [id])
  tableSessions  TableSession[]

  @@unique([storeId, number])
  @@map("bar_tables")
}

model TableSession {
  id           Int      @id @default(autoincrement())
  storeId      Int      @map("store_id")
  barTableId   Int      @map("bar_table_id")
  customerId   Int?     @map("customer_id")
  guests       Int      @default(1) // numero de personas en la mesa
  startedAt    DateTime @default(now()) @map("started_at")
  closedAt     DateTime? @map("closed_at")
  status       String   @default("OPEN") // OPEN, CLOSED
  notes        String?

  store       Store        @relation(fields: [storeId], references: [id])
  barTable    BarTable     @relation(fields: [barTableId], references: [id])
  customer    Customer?    @relation(fields: [customerId], references: [id])
  orders      Order[]
  comandaItems ComandaItem[]

  @@map("table_sessions")
}

model ComandaItem {
  id             Int      @id @default(autoincrement())
  storeId        Int      @map("store_id")
  tableSessionId Int      @map("table_session_id")
  productId      Int?     @map("product_id")
  serviceId      Int?     @map("service_id")
  productName    String   @map("product_name") // nombre al momento de pedir
  quantity       Int
  unitPrice      Int      @map("unit_price") // precio al momento de pedir (pesos)
  total          Int      // quantity * unitPrice (pesos)
  notes          String?  // notas del item (ej: "sin hielo", "extra limon")
  status         String   @default("PENDING") // PENDING, SERVED, PAID, CANCELLED
  createdAt      DateTime @default(now()) @map("created_at")

  store        Store         @relation(fields: [storeId], references: [id])
  tableSession TableSession  @relation(fields: [tableSessionId], references: [id], onDelete: Cascade)
  product      Product?      @relation(fields: [productId], references: [id])
  service      Service?      @relation(fields: [serviceId], references: [id])

  @@map("comanda_items")
}

// ----------------------------------------------
// CONTEXTO: CONTABILIDAD Y FINANZAS
// ----------------------------------------------

model LedgerAccount {
  id        Int     @id @default(autoincrement())
  storeId   Int     @map("store_id")
  name      String
  type      String  // ASSET, LIABILITY, EQUITY, INCOME, EXPENSE
  isDefault Boolean @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt

  store          Store           @relation(fields: [storeId], references: [id])
  journalEntries JournalEntry[]

  @@map("ledger_accounts")
}

model JournalEntry {
  id              Int      @id @default(autoincrement())
  storeId         Int      @map("store_id")
  ledgerAccountId Int      @map("ledger_account_id")
  amount          Int      // siempre positivo
  direction       String   // DEBIT, CREDIT
  description     String?
  referenceType   String?  @map("reference_type") // ORDER, EXPENSE, TOPUP
  referenceId     Int?     @map("reference_id")
  createdAt       DateTime @default(now()) @map("created_at")

  store         Store         @relation(fields: [storeId], references: [id])
  ledgerAccount LedgerAccount @relation(fields: [ledgerAccountId], references: [id])

  @@map("journal_entries")
}

// ----------------------------------------------
// CONTEXTO: SERVICIOS DEL BAR
// ----------------------------------------------

model Service {
  id          Int      @id @default(autoincrement())
  storeId     Int      @map("store_id")
  name        String
  description String?
  price       Int      @default(0) // precio unitario en pesos
  icon        String   @default("Star") // nombre del icono Lucide
  unit        String   @default("servicio") // unidad: "servicio", "unidad", "rollo", "hora"
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt

  store              Store                @relation(fields: [storeId], references: [id])
  serviceTransactions ServiceTransaction[]
  comandaItems        ComandaItem[]
  orderItems         OrderItem[]

  @@unique([storeId, name])
  @@map("services")
}

model ServiceTransaction {
  id           Int      @id @default(autoincrement())
  storeId      Int      @map("store_id")
  serviceId    Int      @map("service_id")
  quantity     Int      @default(1)
  unitPrice    Int      @map("unit_price") // precio al momento de la transaccion (pesos)
  totalAmount  Int      @map("total_amount") // quantity * unitPrice (pesos)
  notes        String?
  status       String   @default("COMPLETED") // COMPLETED, CANCELLED
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt

  store   Store   @relation(fields: [storeId], references: [id])
  service Service @relation(fields: [serviceId], references: [id])

  @@map("service_transactions")
}

// ----------------------------------------------
// CONTEXTO: CAJA REGISTRADORA
// ----------------------------------------------

model CashRegister {
  id              Int       @id @default(autoincrement())
  storeId         Int       @map("store_id")
  userId          Int       @map("user_id")
  openedAt        DateTime  @default(now()) @map("opened_at")
  closedAt        DateTime? @map("closed_at")
  openingBalance  Int       @default(0) @map("opening_balance") // en pesos
  closingBalance  Int?      @map("closing_balance") // en pesos
  expectedCash    Int?      @map("expected_cash") // calculado: apertura + ventas efectivo - pagos fiado
  difference      Int?      @map("difference") // cierre - esperado
  status          String    @default("OPEN") // OPEN, CLOSED
  countBreakdown  String?   @map("count_breakdown") @db.Text // JSON: { CASH: 500000, DAVIPLATA: 200000, ... }
  notes           String?   @db.Text

  store Store @relation(fields: [storeId], references: [id])
  user  User  @relation(fields: [userId], references: [id])
  orders Order[]

  @@map("cash_registers")
}

// ----------------------------------------------
// CONTEXTO: GASTOS OPERACIONALES
// ----------------------------------------------

model Expense {
  id          Int      @id @default(autoincrement())
  storeId     Int      @map("store_id")
  category    String   // ARRIENDO, SERVICIOS, NOMINA, INSUMOS, LICENCIAS, IMPUESTOS, TRANSPORTE, MANTENIMIENTO, OTRO
  description String   // descripcion del gasto
  amount      Int      // monto en pesos
  date        DateTime @default(now())
  notes       String?   @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id])

  @@map("expenses")
}

// ----------------------------------------------
// CONTEXTO: ROLES Y PERMISOS (SaaS)
// ----------------------------------------------

model Role {
  id          Int      @id @default(autoincrement())
  storeId     Int      @map("store_id")
  name        String   // Nombre del rol: Admin, Cajero, Mesero, etc.
  description String?  // Descripcion del rol
  permissions String   @default("{}") @map("permissions") @db.Text // JSON: {"dashboard":true,"pos":true,...}
  isDefault   Boolean  @default(false) @map("is_default") // Rol por defecto para nuevos empleados
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt

  store     Store      @relation(fields: [storeId], references: [id])
  employees Employee[]

  @@unique([storeId, name])
  @@map("roles")
}

// ----------------------------------------------
// CONTEXTO: EMPLEADOS (SaaS)
// ----------------------------------------------

model Employee {
  id          Int      @id @default(autoincrement())
  storeId     Int      @map("store_id")
  userId      Int      @unique @map("user_id")
  roleId      Int?     @map("role_id") // Rol asignado (opcional para compatibilidad)
  position    String?  // Cargo: Cajero, Mesero, Bartender, Administrador, etc.
  permissions String   @default("{}") @map("permissions") @db.Text // JSON override (si no tiene rol)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id])
  user  User  @relation("EmployeeStore", fields: [userId], references: [id])
  role  Role? @relation(fields: [roleId], references: [id])

  @@map("employees")
}

// ----------------------------------------------
// CONTEXTO: COTIZACIONES
// ----------------------------------------------

model Quotation {
  id                Int       @id @default(autoincrement())
  storeId           Int       @map("store_id")
  customerId        Int?      @map("customer_id")
  quotationNumber   String    @map("quotation_number") // COT-260415-0001
  customerName      String?   @map("customer_name")
  customerNit       String?   @map("customer_nit")
  customerEmail     String?   @map("customer_email")
  customerPhone     String?   @map("customer_phone")
  customerAddress   String?   @map("customer_address")
  subtotal          Int       @default(0)
  taxAmount         Int       @default(0) @map("tax_amount")
  taxBreakdown      String?   @map("tax_breakdown") @db.Text // JSON desglose por tipo de impuesto
  discountAmount    Int       @default(0) @map("discount_amount")
  discountType      String    @default("NONE") @map("discount_type") // NONE, PERCENTAGE, FIXED
  total             Int       @default(0)
  validUntil        DateTime? @map("valid_until") // Fecha de validez
  notes             String?   @db.Text
  status            String    @default("ACTIVE") // ACTIVE, CONVERTED, CANCELLED, EXPIRED
  convertedToOrderId Int?     @map("converted_to_order_id")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt

  store    Store            @relation(fields: [storeId], references: [id])
  customer Customer?        @relation(fields: [customerId], references: [id])
  items    QuotationItem[]

  @@map("quotations")
}

model QuotationItem {
  id            Int      @id @default(autoincrement())
  quotationId   Int      @map("quotation_id")
  productId     Int?     @map("product_id")
  productName   String   @map("product_name")
  quantity      Int
  unitPrice     Int      @map("unit_price")
  totalRow      Int      @map("total_row")
  taxCode       String?  @map("tax_code")
  taxRate       Int      @default(0) @map("tax_rate")
  taxAmount     Int      @default(0) @map("tax_amount")
  taxBase       Int      @default(0) @map("tax_base")
  notes         String?

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  product   Product?  @relation(fields: [productId], references: [id])

  @@map("quotation_items")
}
