  returnCode          String    @default("01") @map("return_code")
  // Emisor (supplier info for DIAN)
  supplierNit         String?   @map("supplier_nit")
  supplierName        String?   @map("supplier_name")
  supplierAddress     String?   @map("supplier_address")
  supplierPhone       String?   @map("supplier_phone")
  supplierEmail       String?   @map("supplier_email")
  customerNit         String?   @map("customer_nit")
  customerName        String?   @map("customer_name")
  customerEmail       String?   @map("customer_email")
  customerPhone       String?   @map("customer_phone")
  customerAddress     String?   @map("customer_address")
  customerRegime      String?   @map("customer_regime")
  customerType        String?   @map("customer_type")
  subtotalBase        Int       @default(0) @map("subtotal_base")
  taxExemptAmount     Int       @default(0) @map("tax_exempt_amount")
  taxBreakdown        String?   @map("tax_breakdown")
  totalTaxAmount      Int       @default(0) @map("total_tax_amount")
  totalWithTax        Int       @map("total_with_tax")
  discountAmount      Int       @default(0) @map("discount_amount")
  grandTotal          Int       @map("grand_total")
  cufe                String?
  qrCode              String?   @map("qr_code")
  xmlContent          String?   @map("xml_content")
  referencedInvoiceId String?   @map("referenced_invoice_id")
  referencedPrefix    String?   @map("referenced_prefix")
  referencedConsec    Int?      @map("referenced_consec")
  // JSON array of returned line items: { orderItemId, productName, quantity, unitPrice, taxCode, taxRate, taxAmount, taxBase }[]
  items               String?
  status              String    @default("DRAFT")
  dianResponse        String?   @map("dian_response")
  sentAt              DateTime? @map("sent_at")
  validatedAt         DateTime? @map("validated_at")
  emailedAt           DateTime? @map("emailed_at")
  testMode            Boolean   @default(true) @map("test_mode")
  notes               String?
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt

  store   Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  invoice Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@unique([storeId, prefix, consecutive])
  @@index([storeId])
  @@index([invoiceId])
  @@map("credit_notes")
}

// ----------------------------------------------
// CONTEXTO: NOTAS DEBITO (DIAN)
// ----------------------------------------------

model DebitNote {
