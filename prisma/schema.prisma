  totalWithTax     Int       @map("total_with_tax")
  discountAmount   Int       @default(0) @map("discount_amount")
  tipAmount        Int       @default(0) @map("tip_amount")
  grandTotal       Int       @map("grand_total")
  paymentMethod    String?   @map("payment_method")
  paymentNotes     String?   @map("payment_notes")
  cufe             String?
