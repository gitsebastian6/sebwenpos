// ----------------------------------------------
// CONTEXTO: INVENTARIO Y CATALOGO
// ----------------------------------------------

model Category {
  id        Int      @id @default(autoincrement())
  storeId   Int      @map("store_id")
  name      String
  icon      String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt

  store    Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([storeId, name])
  @@map("categories")
}

model Product {
  id              Int      @id @default(autoincrement())
  storeId         Int      @map("store_id")
  categoryId      Int?     @map("category_id")
  providerId      Int?     @map("provider_id")
  taxRateId       Int?     @map("tax_rate_id")
  sku             String?
  barcode         String?
  name            String
  // Unit-of-measure code for the base "Unidad" (UND, KG, L, etc.) — see
  // UNIT_OF_MEASURE_OPTIONS in src/lib/constants.ts. Purely a label for
  // display/reporting; conversions between presentations still run on
  // unitsPerPack regardless of what this says.
  unitLabel       String   @default("UND") @map("unit_label")
  description     String?
  imgUrl          String?  @map("img_url")
  invima          String?
  costPrice       Int      @default(0) @map("cost_price")
  salePrice       Int
  commission      Int      @default(0) @map("commission")
  // Stock/cantidades en Decimal (precisión QTY_PRECISION=3) para soportar
  // productos por peso/volumen (KG, L, ML). Los precios siguen en Int (COP).
  currentStock    Decimal  @default(0) @map("current_stock")
  minStock        Decimal  @default(5) @map("min_stock")
  // false = stock is never validated/blocked at sale time (e.g. items sold by
  // weight, made-to-order food, anything not counted unit by unit). Purchases
  // and inventory movements still record normally either way.
  trackInventory  Boolean  @default(true) @map("track_inventory")
  // Whether this product is expected to carry lote/fecha de vencimiento on purchases
  // (perishables, medicine, etc). Purely advisory today — used to prompt for those
  // fields in Compras; does not block a purchase if left empty.
  trackExpiration Boolean  @default(false) @map("track_expiration")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt

  store              Store                    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  category           Category?                @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  provider           Provider?                @relation(fields: [providerId], references: [id], onDelete: SetNull)
  taxRate            TaxRate?                 @relation(fields: [taxRateId], references: [id], onDelete: SetNull)
  inventoryMovements InventoryMovement[]
  orderItems         OrderItem[]
  comandaItems       ComandaItem[]
  purchaseItems      PurchaseItem[]
  quotationItems     QuotationItem[]
  costHistories      CostHistory[]
  presentations      ProductPresentation[]
  providerMappings   ProviderProductMapping[]
  batches            Batch[]

  @@unique([storeId, name])
  @@index([categoryId])
  @@index([providerId])
  @@index([taxRateId])
  @@map("products")
}

// ----------------------------------------------
// CONTEXTO: PRESENTACIONES DE PRODUCTO
// ----------------------------------------------
// Un producto vive con su presentación base (los campos sku/barcode/salePrice/
// costPrice/currentStock de arriba en Product SON la presentación "Unidad").
// Esta tabla guarda únicamente presentaciones EXTRA del mismo producto — hasta
// 2 más (3 en total), cada una con su propio código de barras/SKU y precio,
// pero descontando del mismo currentStock de Product (convertido a unidades
// base vía unitsPerPack) — nunca stock separado.
// Ejemplos: Six-pack (unitsPerPack=6) o Cajetilla de cigarrillos (unitsPerPack=20).
model ProductPresentation {
  id           Int      @id @default(autoincrement())
  productId    Int      @map("product_id")
  name         String // "Six-pack", "Caja x24", "Cajetilla"
  unitLabel    String   @default("UND") @map("unit_label") // ver UNIT_OF_MEASURE_OPTIONS — ej. "CAJ" para "Caja x24"
  barcode      String?  @map("barcode")
  sku          String?  @map("sku") // código/referencia del proveedor para esta presentación (homologación)
  unitsPerPack Decimal  @map("units_per_pack") // cuántas unidades base equivale esta presentación
  salePrice    Int      @map("sale_price")
  costPrice    Int      @default(0) @map("cost_price")
  isActive     Boolean  @default(true) @map("is_active")
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt

  product            Product                  @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems         OrderItem[]
  purchaseItems      PurchaseItem[]
  quotationItems     QuotationItem[]
  inventoryMovements InventoryMovement[]
  comandaItems       ComandaItem[]
  providerMappings   ProviderProductMapping[]

  @@index([productId])
  @@index([barcode])
  @@map("product_presentations")
}

model InventoryMovement {
  id               Int      @id @default(autoincrement())
  storeId          Int      @map("store_id")
  productId        Int      @map("product_id")
  presentationId   Int?     @map("presentation_id")
  // Snapshot (survives presentation rename/delete). quantity below is always the
  // BASE-unit delta applied to Product.currentStock — presentationName/unitsPerPack
  // just record which presentation the user picked when entering the movement
  // (e.g. "3 Cajas x24" → quantity = ±72, unitsPerPack = 24).
  presentationName String?  @map("presentation_name")
  unitsPerPack     Decimal  @default(1) @map("units_per_pack")
  quantity         Decimal
  movementType     String   @map("movement_type")
  // Polymorphic reference — an Order.id for SALE/RETURN, a Purchase.id for
  // PURCHASE/PURCHASE_RETURN/ADJUSTMENT, discriminated by movementType. Never
  // give this a real FK/@relation to just one of those tables — Postgres will
  // enforce it against that single table and reject every other movementType.
  referenceId      Int?     @map("reference_id")
  // Lote afectado (trazabilidad FEFO). Nullable: productos sin trackExpiration
  // o movimientos previos a la funcionalidad de lotes no lo tienen.
  batchId          Int?     @map("batch_id")
  notes            String?
  createdAt        DateTime @default(now()) @map("created_at")

  store        Store                @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product      Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  presentation ProductPresentation? @relation(fields: [presentationId], references: [id], onDelete: SetNull)

  @@index([storeId, productId, createdAt])
  @@index([referenceId])
  @@index([presentationId])
  @@map("inventory_movements")
}

// ----------------------------------------------
// CONTEXTO: LOTES (Trazabilidad FEFO)
// ----------------------------------------------
// Trazabilidad por lote para productos perecederos/farmacéuticos
// (Product.trackExpiration = true). La suma de quantity de los lotes ACTIVE
// debe igualar Product.currentStock — verificado por scripts/verify-batches.ts.
// Consumo en ventas: FEFO (first-expired-first-out) vía
// src/domain/inventory/batch-consumer.ts.
model Batch {
  id                Int       @id @default(autoincrement())
  storeId           Int       @map("store_id")
  productId         Int       @map("product_id")
  lotNumber         String    @map("lot_number")
  expiryDate        DateTime? @map("expiry_date")
  manufacturingDate DateTime? @map("manufacturing_date")
  // Unidades base restantes en este lote (Decimal, misma precisión que Product.currentStock)
  quantity          Decimal   @default(0)
  // Costo unitario de entrada en COP (para valuación por lote; el CPP global sigue en Product)
  unitCost          Int       @default(0) @map("unit_cost")
  // Origen: PurchaseItem que creó/entró por última vez al lote (nullable para ajustes manuales)
  purchaseItemId    Int?      @map("purchase_item_id")
  status            String    @default("ACTIVE") // ACTIVE, DEPLETED, EXPIRED, QUARANTINE
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt

  store   Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  purchaseItem PurchaseItem? @relation(fields: [purchaseItemId], references: [id], onDelete: SetNull)

  @@unique([productId, lotNumber])
  @@index([storeId, productId, status])
  @@index([expiryDate])
  @@index([storeId, status, expiryDate])
  @@map("batches")
}

model Purchase {
  id                  Int       @id @default(autoincrement())
  storeId             Int       @map("store_id")
  providerId          Int?      @map("provider_id")
  invoiceNumber       String?   @map("invoice_number")
  documentType        String    @default("FACTURA_COMPRA") @map("document_type") // FACTURA_COMPRA, NOTA_CREDITO, NOTA_DEBITO, RECIBO_CAJA, ORDEN_COMPRA
  consecutiveNumber   String?   @map("consecutive_number")
  date                DateTime  @default(now())
  dueDate             DateTime? @map("due_date")
  paymentTerms        String    @default("CONTADO") @map("payment_terms") // CONTADO, CREDITO_30, CREDITO_60, CREDITO_90
  paymentStatus       String    @default("PENDING") @map("payment_status") // PENDING, PARTIAL, PAID
  amountPaid          Int       @default(0) @map("amount_paid")
  subtotal            Int       @default(0)
  totalIva            Int       @default(0) @map("total_iva")
  totalReteFuente     Int       @default(0) @map("total_rete_fuente")
  totalReteIca        Int       @default(0) @map("total_rete_ica")
  totalReteIva        Int       @default(0) @map("total_rete_iva")
  totalDiscount       Int       @default(0) @map("total_discount")
  // Impuesto al Consumo (IC) — e.g. on beer or bebidas azucaradas. Unlike IVA
  // it is not creditable/descontable, so it's kept as a document-level charge
  // that adds to the total owed and never touches product cost/CPP.
  totalConsumptionTax Int       @default(0) @map("total_consumption_tax")
  notes               String?
  total               Int       @default(0)
  status              String    @default("COMPLETED") // PENDING, APPROVED, RECEIVED, PARTIAL, COMPLETED, CANCELLED
  createdById         Int?      @map("created_by_id")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt

  store              Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  provider           Provider?         @relation(fields: [providerId], references: [id], onDelete: SetNull)
  purchaseItems      PurchaseItem[]
  purchasePayments   PurchasePayment[]
  costHistoryRecords CostHistory[]
  createdBy          User?             @relation("UserPurchases", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([storeId])
  @@index([providerId])
  @@index([storeId, date])
  @@index([status])
  @@map("purchases")
}

model PurchaseItem {
  id                Int       @id @default(autoincrement())
  purchaseId        Int       @map("purchase_id")
  productId         Int       @map("product_id")
  presentationId    Int?      @map("presentation_id")
  // Snapshots (survive presentation rename/delete) — quantity/unitCost above are
  // always denominated in THIS presentation's own unit (e.g. "5 cajas x24"), and
  // unitsPerPack is what converts them into base-unit stock movements.
  presentationName  String?   @map("presentation_name")
  unitsPerPack      Decimal   @default(1) @map("units_per_pack")
  quantity          Decimal
  returnedQuantity  Decimal   @default(0) @map("returned_quantity")
  unitCost          Int       @map("unit_cost")
  ivaRate           Int       @default(0) @map("iva_rate") // IVA % for this item (0 = exento, 19, 5, etc.)
  ivaAmount         Int       @default(0) @map("iva_amount")
  discountAmount    Int       @default(0) @map("discount_amount")
  lotNumber         String?   @map("lot_number")
  expiryDate        DateTime? @map("expiry_date")
  manufacturingDate DateTime? @map("manufacturing_date")
  // True cuando la línea se detectó/marcó como bonificada o gratis (PriceAmount=0
  // en el XML, un AllowanceCharge que cubre ~100% del valor, o el checkbox
  // "Bonificado" en captura manual). Solo informativo para reportes/Kardex —
  // nunca cambia el cálculo de CPP (unitCost=0 ya fluye correctamente por la
  // fórmula de costo promedio ponderado existente).
  isBonus           Boolean   @default(false) @map("is_bonus")
  total             Int // unitCost * quantity + ivaAmount - discountAmount

  purchase     Purchase             @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product      Product              @relation(fields: [productId], references: [id], onDelete: Restrict)
  presentation ProductPresentation? @relation(fields: [presentationId], references: [id], onDelete: SetNull)
  batches      Batch[]

  @@index([purchaseId])
  @@index([productId])
  @@index([presentationId])
  @@map("purchase_items")
}

model Provider {
  id             Int      @id @default(autoincrement())
  storeId        Int      @map("store_id")
  name           String
  contactName    String?  @map("contact_name")
  phone          String?
  email          String?
  address        String?
  city           String?
  nit            String?
  dv             String? // Dígito de verificación
  regime         String   @default("NO_RESPONSABLE") // RESPONSABLE, NO_RESPONSABLE, SIMPLIFICADO, GRAN_CONTRIBUTUYENTE
  autoretainer   Boolean  @default(false) @map("autoretainer") // Autoretenedor de IVA
  paymentTerms   String   @default("CONTADO") @map("payment_terms") // CONTADO, CREDITO_30, CREDITO_60, CREDITO_90
  // Días hábiles entre pedido y entrega (lead time) — usado para el cálculo
  // de punto de reorden (ROP = demanda × leadTime + safety stock).
  leadTimeDays   Int      @default(7) @map("lead_time_days")
  creditLimit    Int      @default(0) @map("credit_limit")
  totalDebt      Int      @default(0) @map("total_debt")
  totalPurchases Int      @default(0) @map("total_purchases")
  notes          String?
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt

  store           Store                    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  products        Product[]
  purchases       Purchase[]
  productMappings ProviderProductMapping[]

  @@unique([storeId, name])
  @@index([storeId, nit])
  @@map("providers")
}

// Homologación por proveedor: recuerda a qué producto/presentación
// corresponde el código propio de CADA proveedor (cac:SellersItemIdentification
// del XML), para que la siguiente factura del mismo proveedor con ese mismo
// código resuelva sola, sin volver a preguntar. El código de barras NO pasa
// por aquí — es universal y ya se resuelve directo contra
// Product.barcode/ProductPresentation.barcode; esta tabla es específicamente
// para los códigos internos que varían de proveedor a proveedor.
model ProviderProductMapping {
  id             Int      @id @default(autoincrement())
  storeId        Int      @map("store_id")
  providerId     Int      @map("provider_id")
  sellerSku      String   @map("seller_sku") // siempre recortado + en minúsculas
  productId      Int      @map("product_id")
  presentationId Int?     @map("presentation_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt

  store        Store                @relation(fields: [storeId], references: [id], onDelete: Cascade)
  provider     Provider             @relation(fields: [providerId], references: [id], onDelete: Cascade)
  product      Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  presentation ProductPresentation? @relation(fields: [presentationId], references: [id], onDelete: SetNull)

  @@unique([providerId, sellerSku])
  @@index([storeId])
  @@index([productId])
  @@map("provider_product_mappings")
}

// ----------------------------------------------
// CONTEXTO: PAGOS A PROVEEDORES
// ----------------------------------------------

model PurchasePayment {
  id            Int      @id @default(autoincrement())
  purchaseId    Int      @map("purchase_id")
  storeId       Int      @map("store_id")
  amount        Int
  paymentMethod String   @default("CASH") @map("payment_method") // CASH, TRANSFER, CHECK, CARD
  reference     String?
  notes         String?
  createdById   Int?     @map("created_by_id")
  createdAt     DateTime @default(now()) @map("created_at")

  purchase  Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdBy User?    @relation("UserPurchasePayments", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([purchaseId])
  @@index([storeId])
  @@map("purchase_payments")
}

// ----------------------------------------------
// CONTEXTO: HISTORIAL DE COSTOS POR PRODUCTO
// ----------------------------------------------

model CostHistory {
  id           Int      @id @default(autoincrement())
  productId    Int      @map("product_id")
  storeId      Int      @map("store_id")
  previousCost Int      @map("previous_cost")
  newCost      Int      @map("new_cost")
  purchaseId   Int?     @map("purchase_id")
  reason       String? // PURCHASE, MANUAL, ADJUSTMENT
  createdAt    DateTime @default(now()) @map("created_at")

  product  Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  store    Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  purchase Purchase? @relation(fields: [purchaseId], references: [id], onDelete: SetNull)

  @@index([productId, createdAt])
  @@index([storeId])
  @@map("cost_histories")
}

// ----------------------------------------------
// CONTEXTO: VENTAS Y COMERCIO
// ----------------------------------------------

model Customer {
  id           Int       @id @default(autoincrement())
  storeId      Int       @map("store_id")
  name         String
  phone        String?
  email        String?
  nit          String?
  documentType String?   @map("document_type")
  address      String?
  regime       String?
  totalDebt    Int       @default(0) @map("total_debt")
  // When the customer's debt started accruing from $0 — reset to null once totalDebt
  // reaches 0 again. Approximates "how long has this debt been outstanding" for the
  // Índice de Morosidad (no per-order debt itemization exists to age precisely).
  debtSince    DateTime? @map("debt_since")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt

  store         Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  orders        Order[]
  tableSessions TableSession[]
  quotations    Quotation[]
  payments      CustomerPayment[]

  @@index([storeId])
  @@map("customers")
}

model Order {
  id               Int      @id @default(autoincrement())
  storeId          Int      @map("store_id")
  customerId       Int?     @map("customer_id")
  tableSessionId   Int?     @map("table_session_id")
  cashRegisterId   Int?     @map("cash_register_id")
  soldByEmployeeId Int?     @map("sold_by_employee_id")
  orderNumber      String   @map("order_number")
  subtotal         Int
  taxAmount        Int      @default(0) @map("tax_amount")
  taxBreakdown     String?  @map("tax_breakdown")
  tipAmount        Int      @default(0) @map("tip_amount")
  discountAmount   Int      @default(0) @map("discount_amount")
  discountType     String   @default("NONE") @map("discount_type")
  discountReason   String?  @map("discount_reason")
  total            Int
  status           String   @default("COMPLETED")
  paymentMethod    String   @default("CASH") @map("payment_method")
  paymentSplits    String?  @map("payment_splits")
  notes            String?
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt

  store            Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer         Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  tableSession     TableSession?     @relation(fields: [tableSessionId], references: [id], onDelete: SetNull)
  cashRegister     CashRegister?     @relation(fields: [cashRegisterId], references: [id], onDelete: SetNull)
  soldByEmployee   Employee?         @relation(fields: [soldByEmployeeId], references: [id], onDelete: SetNull)
  orderItems       OrderItem[]
  invoice          Invoice?
  wompiTransaction WompiTransaction?

  @@unique([storeId, orderNumber])
  @@index([storeId, createdAt])
  @@index([storeId, status])
  @@index([customerId])
  @@index([tableSessionId])
  @@index([cashRegisterId])
  @@index([soldByEmployeeId])
  @@map("orders")
}

model OrderItem {
  id               Int     @id @default(autoincrement())
  orderId          Int     @map("order_id")
  productId        Int?    @map("product_id")
  serviceId        Int?    @map("service_id")
  presentationId   Int?    @map("presentation_id")
  // Snapshots (survive presentation rename/delete) — receipts/returns/history
  // must keep showing what was actually sold, and stock must keep restoring
  // at the right base-unit ratio, regardless of later product edits.
  presentationName String? @map("presentation_name")
  unitsPerPack     Decimal @default(1) @map("units_per_pack")
  quantity         Decimal
  returnedQuantity Decimal @default(0) @map("returned_quantity")
  unitPrice        Int     @map("unit_price")
  totalRow         Int     @map("total_row")
  taxCode          String? @map("tax_code")
  taxRate          Int     @default(0) @map("tax_rate")
  taxAmount        Int     @default(0) @map("tax_amount")
  taxBase          Int     @default(0) @map("tax_base")
  notes            String?

  order        Order                @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product      Product?             @relation(fields: [productId], references: [id], onDelete: SetNull)
  service      Service?             @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  presentation ProductPresentation? @relation(fields: [presentationId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
  @@index([serviceId])
  @@index([presentationId])
  @@map("order_items")
}

// ----------------------------------------------
// CONTEXTO: MESAS Y COMANDAS (RESTAURANTE/BAR)
// ----------------------------------------------

model BarTable {
  id        Int      @id @default(autoincrement())
  storeId   Int      @map("store_id")
  number    Int
  name      String?
  capacity  Int      @default(4)
  zone      String   @default("PRINCIPAL")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt

  store         Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  tableSessions TableSession[]

  @@unique([storeId, number])
  @@map("bar_tables")
}

model TableSession {
  id         Int       @id @default(autoincrement())
  storeId    Int       @map("store_id")
  barTableId Int       @map("bar_table_id")
  customerId Int?      @map("customer_id")
  guests     Int       @default(1)
  startedAt  DateTime  @default(now()) @map("started_at")
  closedAt   DateTime? @map("closed_at")
  status     String    @default("OPEN")
  notes      String?

  store        Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  barTable     BarTable      @relation(fields: [barTableId], references: [id], onDelete: Cascade)
  customer     Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  orders       Order[]
  comandaItems ComandaItem[]

  @@index([storeId])
  @@index([barTableId])
  @@index([customerId])
  @@map("table_sessions")
}

model ComandaItem {
  id               Int      @id @default(autoincrement())
  storeId          Int      @map("store_id")
  tableSessionId   Int      @map("table_session_id")
  productId        Int?     @map("product_id")
  serviceId        Int?     @map("service_id")
  presentationId   Int?     @map("presentation_id")
  // Snapshot (survives presentation rename/delete). unitPrice/total above are
  // always denominated in THIS presentation's own unit (e.g. "2 Cajas x24"),
  // and unitsPerPack is what converts them into base-unit stock movements
  // when the session is paid (see tables/sessions/[id]/pay).
  presentationName String?  @map("presentation_name")
  unitsPerPack     Decimal  @default(1) @map("units_per_pack")
  productName      String   @map("product_name")
  quantity         Decimal
  unitPrice        Int      @map("unit_price")
  total            Int
  notes            String?
  status           String   @default("PENDING")
  createdAt        DateTime @default(now()) @map("created_at")

  store        Store                @relation(fields: [storeId], references: [id], onDelete: Cascade)
  tableSession TableSession         @relation(fields: [tableSessionId], references: [id], onDelete: Cascade)
  product      Product?             @relation(fields: [productId], references: [id], onDelete: SetNull)
  service      Service?             @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  presentation ProductPresentation? @relation(fields: [presentationId], references: [id], onDelete: SetNull)

  @@index([storeId])
  @@index([tableSessionId])
  @@index([productId])
  @@index([serviceId])
  @@index([presentationId])
  @@map("comanda_items")
}

// ----------------------------------------------
// CONTEXTO: CONTABILIDAD Y FINANZAS
// ----------------------------------------------

model LedgerAccount {
  id        Int      @id @default(autoincrement())
  storeId   Int      @map("store_id")
  name      String
  type      String
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt

  store          Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  journalEntries JournalEntry[]

  @@index([storeId])
  @@map("ledger_accounts")
}

model JournalEntry {
  id              Int      @id @default(autoincrement())
  storeId         Int      @map("store_id")
  ledgerAccountId Int      @map("ledger_account_id")
  amount          Int
  direction       String
  description     String?
  referenceType   String?  @map("reference_type")
  referenceId     Int?     @map("reference_id")
  createdAt       DateTime @default(now()) @map("created_at")

  store         Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  ledgerAccount LedgerAccount @relation(fields: [ledgerAccountId], references: [id], onDelete: Cascade)

  @@index([storeId, ledgerAccountId])
  @@map("journal_entries")
}

// ----------------------------------------------
// CONTEXTO: SERVICIOS DEL BAR
// ----------------------------------------------

model Service {
  id             Int      @id @default(autoincrement())
  storeId        Int      @map("store_id")
  name           String
  description    String?
  price          Int      @default(0)
  icon           String   @default("Star")
  unit           String   @default("servicio")
  // % de comisión sobre venta neta específico de este servicio — tiene prioridad
  // sobre el commissionRate del empleado que lo vendió. null/0 = usa el del empleado.
  commissionRate Int?     @map("commission_rate")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt

  store               Store                @relation(fields: [storeId], references: [id], onDelete: Cascade)
  serviceTransactions ServiceTransaction[]
  comandaItems        ComandaItem[]
  orderItems          OrderItem[]

  @@unique([storeId, name])
  @@map("services")
}

model ServiceTransaction {
  id          Int      @id @default(autoincrement())
  storeId     Int      @map("store_id")
  serviceId   Int      @map("service_id")
  // Decimal (QTY_PRECISION=3) para consistencia con el resto de cantidades
  // (ej. 1.5 horas de consultoría). Precios siguen en Int (COP).
  quantity    Decimal  @default(1)
  unitPrice   Int      @map("unit_price")
  totalAmount Int      @map("total_amount")
  notes       String?
  status      String   @default("COMPLETED")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt

  store   Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@index([serviceId])
  @@map("service_transactions")
}

// ----------------------------------------------
// CONTEXTO: CAJA REGISTRADORA
// ----------------------------------------------

model CashRegister {
  id             Int       @id @default(autoincrement())
  storeId        Int       @map("store_id")
  userId         Int?      @map("user_id")
  openedAt       DateTime  @default(now()) @map("opened_at")
  closedAt       DateTime? @map("closed_at")
  openingBalance Int       @default(0) @map("opening_balance")
  closingBalance Int?      @map("closing_balance")
  expectedCash   Int?      @map("expected_cash")
  difference     Int?      @map("difference")
  status         String    @default("OPEN")
  countBreakdown String?   @map("count_breakdown")
  notes          String?

  store            Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user             User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  orders           Order[]
  expenses         Expense[]
  customerPayments CustomerPayment[]

  @@index([storeId, status])
  @@index([userId])
  @@map("cash_registers")
}

// ----------------------------------------------
// CONTEXTO: GASTOS OPERACIONALES
// ----------------------------------------------

model Expense {
  id             Int      @id @default(autoincrement())
  storeId        Int      @map("store_id")
  category       String
  description    String
  amount         Int
  date           DateTime @default(now())
  notes          String?
  // Set only when the expense was paid in cash out of an open register's till
  // (gasto de caja menor) — used to compute the register's expectedCash on close.
  cashRegisterId Int?     @map("cash_register_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt

  store        Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  cashRegister CashRegister? @relation(fields: [cashRegisterId], references: [id], onDelete: SetNull)

  @@index([storeId, date])
  @@index([cashRegisterId])
  @@map("expenses")
}

// ----------------------------------------------
// CONTEXTO: ABONOS A CARTERA (CxC)
// ----------------------------------------------

model CustomerPayment {
  id             Int      @id @default(autoincrement())
  storeId        Int      @map("store_id")
  customerId     Int      @map("customer_id")
  amount         Int
  paymentMethod  String   @default("CASH") @map("payment_method")
  // Set only when paid in cash into an open register's till — used to compute
  // the register's expectedCash on close (Recaudos CxC).
  cashRegisterId Int?     @map("cash_register_id")
  notes          String?
  createdAt      DateTime @default(now()) @map("created_at")

  store        Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer     Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  cashRegister CashRegister? @relation(fields: [cashRegisterId], references: [id], onDelete: SetNull)

  @@index([storeId, createdAt])
  @@index([customerId])
  @@index([cashRegisterId])
  @@map("customer_payments")
}

// ----------------------------------------------
// CONTEXTO: ROLES Y PERMISOS (SaaS)
// ----------------------------------------------

model Role {
  id          Int      @id @default(autoincrement())
  storeId     Int      @map("store_id")
  name        String
  description String?
  permissions String   @default("{}") @map("permissions")
  isDefault   Boolean  @default(false) @map("is_default")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt

  store     Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  employees Employee[]

  @@unique([storeId, name])
  @@map("roles")
}

// ----------------------------------------------
// CONTEXTO: EMPLEADOS (SaaS)
// ----------------------------------------------

model Employee {
  id             Int      @id @default(autoincrement())
  storeId        Int      @map("store_id")
  userId         Int      @unique @map("user_id")
  roleId         Int?     @map("role_id")
  position       String?
  permissions    String   @default("{}") @map("permissions")
  // % de comisión sobre venta neta (sin impuestos) cuando el item vendido no tiene
  // su propio commissionRate en Service — ej. 5 = 5%. null/0 = sin comisión.
  commissionRate Int?     @map("commission_rate")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt

  store  Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user   User    @relation("EmployeeStore", fields: [userId], references: [id], onDelete: Restrict)
  role   Role?   @relation(fields: [roleId], references: [id], onDelete: SetNull)
  orders Order[]

  @@index([storeId])
  @@index([roleId])
  @@map("employees")
}

// ----------------------------------------------
// CONTEXTO: COTIZACIONES
// ----------------------------------------------

model Quotation {
  id                 Int       @id @default(autoincrement())
  storeId            Int       @map("store_id")
  customerId         Int?      @map("customer_id")
  quotationNumber    String    @map("quotation_number")
  customerName       String?   @map("customer_name")
  customerNit        String?   @map("customer_nit")
  customerEmail      String?   @map("customer_email")
  customerPhone      String?   @map("customer_phone")
  customerAddress    String?   @map("customer_address")
  subtotal           Int       @default(0)
  taxAmount          Int       @default(0) @map("tax_amount")
  taxBreakdown       String?   @map("tax_breakdown")
  discountAmount     Int       @default(0) @map("discount_amount")
  discountType       String    @default("NONE") @map("discount_type")
  total              Int       @default(0)
  validUntil         DateTime? @map("valid_until")
  notes              String?
  status             String    @default("ACTIVE")
  convertedToOrderId Int?      @map("converted_to_order_id")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt

  store    Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items    QuotationItem[]

  @@unique([storeId, quotationNumber])
  @@index([storeId])
  @@index([customerId])
  @@map("quotations")
}

model QuotationItem {
  id               Int     @id @default(autoincrement())
  quotationId      Int     @map("quotation_id")
  productId        Int?    @map("product_id")
  productName      String  @map("product_name")
  presentationId   Int?    @map("presentation_id")
  // Snapshot (survives presentation rename/delete) — mirrors OrderItem/PurchaseItem.
  presentationName String? @map("presentation_name")
  unitsPerPack     Decimal @default(1) @map("units_per_pack")
  quantity         Decimal
  unitPrice        Int     @map("unit_price")
  totalRow         Int     @map("total_row")
  taxCode          String? @map("tax_code")
  taxRate          Int     @default(0) @map("tax_rate")
  taxAmount        Int     @default(0) @map("tax_amount")
  taxBase          Int     @default(0) @map("tax_base")
  notes            String?

  quotation    Quotation            @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  product      Product?             @relation(fields: [productId], references: [id], onDelete: SetNull)
  presentation ProductPresentation? @relation(fields: [presentationId], references: [id], onDelete: SetNull)

  @@index([quotationId])
  @@index([productId])
  @@index([presentationId])
  @@map("quotation_items")
}

// ----------------------------------------------
// CONTEXTO: CONFIGURACIÓN DEL SISTEMA (Global)
// ----------------------------------------------

model SystemSetting {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String   @default("")
  updatedAt DateTime @updatedAt

  @@map("system_settings")
}

// ----------------------------------------------
// CONTEXTO: TRANSACCIONES WOMPI (Payment Gateway)
// ----------------------------------------------

model WompiTransaction {
  id                 Int       @id @default(autoincrement())
  storeId            Int       @map("store_id")
  subscriptionId     Int?      @map("subscription_id") // For subscription payments
  orderId            Int?      @unique @map("order_id") // For POS payments
  receiptId          Int?      @unique @map("receipt_id") // Linked PaymentReceipt
  wompiId            String?   @map("wompi_id") // Wompi's transaction ID
  wompiPaymentLinkId String?   @map("wompi_payment_link_id")
  reference          String    @map("reference") // Our internal reference
  amount             Int // COP (Wompi uses cents, we store as whole COP)
  amountInCents      Int       @map("amount_in_cents") // Wompi format (COP * 100)
  currency           String    @default("COP") @map("currency")
  paymentMethod      String?   @map("payment_method") // CARD, NEQUI, DAVIPLATA, PSE, BANCOLOMBIA
  paymentMethodType  String?   @map("payment_method_type") // CARD, NEQUI, etc from Wompi
  status             String    @default("PENDING") // PENDING, APPROVED, DECLINED, VOIDED, ERROR
  wompiStatus        String?   @map("wompi_status") // Raw status from Wompi
  customerEmail      String?   @map("customer_email")
  customerName       String?   @map("customer_name")
  customerPhone      String?   @map("customer_phone")
  customerDocument   String?   @map("customer_document") // Cédula/NIT
  metadata           String    @default("{}") @map("metadata") // JSON with extra context
  wompiResponse      String?   @map("wompi_response") // Full Wompi response JSON
  paidAt             DateTime? @map("paid_at")
  expiresAt          DateTime? @map("expires_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt

  store        Store?          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  subscription Subscription?   @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  order        Order?          @relation(fields: [orderId], references: [id], onDelete: SetNull)
  receipt      PaymentReceipt? @relation(fields: [receiptId], references: [id], onDelete: SetNull)

  @@unique([reference])
  @@index([storeId])
  @@index([subscriptionId])
  @@index([orderId])
  @@index([wompiId])
  @@index([status])
  @@index([createdAt])
  @@map("wompi_transactions")
}

// ----------------------------------------------
// CONTEXTO: ASISTENTE AI (GLM Chat Provider)
// ----------------------------------------------

model ChatSession {
  id           Int      @id @default(autoincrement())
  sessionId    String   @unique @map("session_id") // UUID for client-side tracking
  userId       Int      @map("user_id")
  storeId      Int?     @map("store_id")
  title        String? // Auto-generated from first message
  tokensUsed   Int      @default(0) @map("tokens_used")
  messageCount Int      @default(0) @map("message_count")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt

  messages ChatMessage[]

  @@index([userId])
  @@index([storeId])
  @@index([sessionId])
  @@index([createdAt])
  @@map("chat_sessions")
}

model ChatMessage {
  id        Int      @id @default(autoincrement())
  sessionId Int      @map("session_id")
  role      String // system, user, assistant
  content   String
  tokens    Int      @default(0) // Token count for this message
  model     String? // GLM model used
  latencyMs Int?     @map("latency_ms") // Response time in ms
  createdAt DateTime @default(now()) @map("created_at")

  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([createdAt])
  @@map("chat_messages")
}

// ----------------------------------------------
// CONTEXTO: PWA PUSH NOTIFICATIONS
// ----------------------------------------------

model PushSubscription {
  id        Int      @id @default(autoincrement())
  storeId   Int      @map("store_id")
  userId    Int      @map("user_id")
  endpoint  String   @unique
  p256dh    String // Public key for encryption
  auth      String // Auth secret
  userAgent String?  @map("user_agent") // Browser/device info
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@index([userId])
  @@index([endpoint])
  @@map("push_subscriptions")
}

// ─── Invoice Counter (atomic consecutive generation) ─────────
// Ref: Designing Data-Intensive Applications (Kleppmann), Ch. 7
// Prevents the "lost update" race on MAX(consecutive) that could
// produce duplicate DIAN invoice numbers under concurrent access.
// A single row per store; atomically incremented via upsert + increment.

model InvoiceCounter {
  id              Int      @id @default(autoincrement())
  storeId         Int      @unique @map("store_id")
  lastConsecutive Int      @default(0) @map("last_consecutive")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("invoice_counters")
}

// ----------------------------------------------
// CONTEXTO: IDEMPOTENCIA DE ÓRDENES (Kleppmann Ch. 11)
// ----------------------------------------------
// Persiste la relación entre una Idempotency-Key enviada por el cliente y la
// orden que se creó a partir de ella, de modo que un POST reintentado (p.ej.
// tras un timeout donde el servidor sí procesó la venta pero la respuesta se
// perdió) devuelva la misma orden en lugar de duplicarla. La inserción ocurre
// dentro de la misma transacción que crea la orden, y un @@unique elimina la
// race condition entre reintentos concurrentes (P2002 → replay).

model ProcessedRequest {
  id             Int      @id @default(autoincrement())
  storeId        Int      @map("store_id")
  idempotencyKey String   @map("idempotency_key")
  orderId        Int      @map("order_id")
  createdAt      DateTime @default(now()) @map("created_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, idempotencyKey])
  @@index([storeId, idempotencyKey])
  @@map("processed_requests")
}

// Idempotencia GENERALIZADA para entry points externos (Kleppmann Ch.7):
// webhooks (Wompi), callbacks de pasarelas, etc. Registra la identidad del
// evento externo ANTES de procesarlo; el @@unique convierte un reintento
// concurrente en P2002 → replay/skip en vez de duplicar efectos secundarios.
// A diferencia de ProcessedRequest (acoplada a órdenes), esta tabla es
// genérica: cualquier source + externalId.
model ProcessedEvent {
  id          Int      @id @default(autoincrement())
  source      String // WOMPI, STRIPE, DIAN_CALLBACK, ...
  externalId  String   @map("external_id") // id del evento/transacción externa
  entityType  String?  @map("entity_type") // WompiTransaction, PaymentReceipt...
  entityId    Int?     @map("entity_id")
  receivedAt  DateTime @default(now()) @map("received_at")

  @@unique([source, externalId])
  @@index([source, externalId])
  @@map("processed_events")
}
