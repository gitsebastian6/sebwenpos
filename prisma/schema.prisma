generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ╔══════════════════════════════════════════════════════════════════╗
// ║  VENTIFY POS — Hybrid Schema (SQLite dev / PostgreSQL prod)    ║
// ║  ─────────────────────────────────────────────────────────────  ║
// ║  DEVELOPMENT: SQLite (file:./db/custom.db) — zero config        ║
// ║  PRODUCTION:  PostgreSQL — change provider + DATABASE_URL       ║
// ║                                                                  ║
// ║  To migrate to PostgreSQL:                                      ║
// ║    1. Change provider below to "postgresql"                     ║
// ║    2. Change DATABASE_URL in .env to postgresql://...           ║
// ║    3. Run: bunx prisma generate && bunx prisma db push          ║
// ║    4. Run: bun prisma/migrate-sqlite-to-pg.ts                   ║
// ║    5. Update src/lib/db.ts to use PrismaPg adapter              ║
// ║                                                                  ║
// ║  All raw SQL queries use src/lib/db-dialect.ts helper which      ║
// ║  auto-detects the dialect from DATABASE_URL.                    ║
// ╚══════════════════════════════════════════════════════════════════╝

// ----------------------------------------------
// CONTEXTO: HISTORIAL DE EVENTOS DEL SISTEMA (SaaS Analytics)
// ----------------------------------------------

model StoreEventLog {
  id          Int      @id @default(autoincrement())
  storeId     Int      @map("store_id")
  eventType   String   @map("event_type")
  // STORE_CREATED, STORE_ACTIVATED, TRIAL_STARTED, TRIAL_ENDED,
  // SUBSCRIPTION_ACTIVE, SUBSCRIPTION_PAST_DUE, SUBSCRIPTION_CANCELLED,
  // SUBSCRIPTION_REACTIVATED, PLAN_UPGRADED, PLAN_DOWNGRADED,
  // BRANCH_CREATED, STORE_DELETED
  previousValue String? @map("previous_value")
  newValue     String?  @map("new_value")
  metadata    String   @default("{}") @map("metadata")
  createdAt   DateTime @default(now()) @map("created_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, eventType])
  @@index([eventType, createdAt])
  @@index([createdAt])
  @@map("store_event_logs")
}

// ----------------------------------------------
// CONTEXTO: IDENTIDAD Y ACCESO
// ----------------------------------------------

model User {
  id           Int      @id @default(autoincrement())
  cedula       String   @unique
  phone        String?
  email        String?
  passwordHash String
  fullName     String?  @map("full_name")
  role         String   @default("OWNER") // SUPER_ADMIN, OWNER, EMPLOYEE
  securityQuestion  String?   @map("security_question")
  securityAnswer    String?   @map("security_answer")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt

  store    Store?    @relation("UserStore")
  employee Employee? @relation("EmployeeStore")

  cashRegisters    CashRegister[]
  purchases        Purchase[]       @relation("UserPurchases")
  purchasePaymentRecords PurchasePayment[] @relation("UserPurchasePayments")

  @@map("users")
}

// ----------------------------------------------
// CONTEXTO: OTP (One-Time Password) para WhatsApp
// ----------------------------------------------

model OtpToken {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  phone     String
  code      String
  verified  Boolean  @default(false)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("otp_tokens")
}

model Store {
  id           Int      @id @default(autoincrement())
  userId       Int      @unique @map("user_id")
  name         String
  legalName    String?  @map("legal_name")
  nit          String?
  address      String?
  phone        String?
  currencyCode String   @default("COP") @map("currency_code")
  countryCode  String?  @map("country_code")
  // DIAN Resolution (Facturación Electrónica)
  invoicePrefix          String?  @map("invoice_prefix")
  resolutionNumber       String?  @map("resolution_number")
  resolutionStartDate    DateTime? @map("resolution_start_date")
  resolutionEndDate      DateTime? @map("resolution_end_date")
  resolutionStartNumber  Int?     @map("resolution_start_number")
  resolutionEndNumber    Int?     @map("resolution_end_number")
  invoiceTestMode        Boolean  @default(true) @map("invoice_test_mode")
  // Facturación Electrónica Híbrida
  invoiceProvider        String   @default("NONE") @map("invoice_provider")
  invoiceEnabled         Boolean  @default(false) @map("invoice_enabled")
  certificateUploaded    Boolean  @default(false) @map("certificate_uploaded")
  certificatePassword    String?  @map("certificate_password")
  softwareId             String?  @map("software_id")
  softwarePin            String?  @map("software_pin")
  providerConfig         String   @default("{}") @map("provider_config")
  // DIVIPOLA (código municipio DIAN)
  divipolaCode           String?  @map("divipola_code")
  cityName               String?  @map("city_name")
  // Sucursal / Branch support
  parentStoreId          Int?     @map("parent_store_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt

  user                User                 @relation("UserStore", fields: [userId], references: [id], onDelete: Restrict)
  parentStore         Store?               @relation("StoreBranches", fields: [parentStoreId], references: [id])
  branches            Store[]              @relation("StoreBranches")
  employees           Employee[]
  roles               Role[]
  categories          Category[]
  products            Product[]
  inventoryMovements  InventoryMovement[]
  customers           Customer[]
  orders              Order[]
  ledgerAccounts      LedgerAccount[]
  journalEntries      JournalEntry[]
  services            Service[]
  serviceTransactions ServiceTransaction[]
  barTables           BarTable[]
  tableSessions       TableSession[]
  comandaItems        ComandaItem[]
  providers           Provider[]
  purchases           Purchase[]
  cashRegisters       CashRegister[]
  expenses            Expense[]
  taxRates            TaxRate[]
  invoices            Invoice[]
  creditNotes         CreditNote[]
  contingencyInvoices ContingencyInvoice[]
  quotations          Quotation[]
  subscription        Subscription?
  paymentReceipts     PaymentReceipt[]
  subscriptionHistories SubscriptionHistory[]
  billingRecords      BillingRecord[]
  purchasePayments    PurchasePayment[]
  costHistories       CostHistory[]
  storeEventLogs     StoreEventLog[]

  @@map("stores")
}

// ----------------------------------------------
// CONTEXTO: PLANES Y SUSCRIPCIONES (SaaS)
// ----------------------------------------------

model Plan {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  price       Int
  maxStores         Int @default(1) @map("max_stores")
  maxEmployees      Int @default(5) @map("max_employees")
  maxProducts       Int @default(100) @map("max_products")
  features    String   @default("{}") @map("features")
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt

  subscriptions Subscription[]

  @@unique([name])
  @@map("plans")
}

model Subscription {
  id             Int       @id @default(autoincrement())
  storeId        Int       @unique @map("store_id")
  planId         Int       @map("plan_id")
  status         String    @default("TRIAL")
  startDate      DateTime  @default(now()) @map("start_date")
  endDate        DateTime? @map("end_date")
  trialEndDate   DateTime? @map("trial_end_date")
  graceEndDate   DateTime? @map("grace_end_date")
  cancelReason   String?   @map("cancel_reason")
  billingPeriod  String    @default("MONTHLY") @map("billing_period")
  billingPrice   Int
  lastBilledAt   DateTime? @map("last_billed_at")
  nextBillingAt  DateTime? @map("next_billing_at")
  // ── Proration: credit for unused days when changing plans ──
  prorationCredit Int      @default(0) @map("proration_credit")
  previousPlanId  Int?     @map("previous_plan_id")
  previousPlanName String? @map("previous_plan_name")
  proratedDaysRemaining Int @default(0) @map("prorated_days_remaining")
  // ── Expiry alert tracking ──
  alertSentAt3d  DateTime? @map("alert_sent_at_3d")
  alertSentAt1d  DateTime? @map("alert_sent_at_1d")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt

  store            Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  plan            Plan              @relation(fields: [planId], references: [id], onDelete: Restrict)
  paymentReceipts PaymentReceipt[]
  subscriptionHistories SubscriptionHistory[]
  billingRecords  BillingRecord[]

  @@index([planId])
  @@map("subscriptions")
}

// ----------------------------------------------
// CONTEXTO: COMPROBANTES DE PAGO
// ----------------------------------------------

model SubscriptionHistory {
  id             Int      @id @default(autoincrement())
  storeId        Int      @map("store_id")
  subscriptionId Int      @map("subscription_id")
  eventType      String   @map("event_type") // CREATED, RENEWED, CANCELLED, PLAN_CHANGED, EXPIRED, REACTIVATED, TRIAL_STARTED, GRACE_STARTED, BILLING_PERIOD_CHANGED
  previousStatus String?  @map("previous_status")
  newStatus      String?  @map("new_status")
  previousPlanId Int?     @map("previous_plan_id")
  newPlanId      Int?     @map("new_plan_id")
  previousPlanName String? @map("previous_plan_name")
  newPlanName    String?  @map("new_plan_name")
  description    String?
  metadata       String   @default("{}") @map("metadata") // JSON with extra context
  createdAt      DateTime @default(now()) @map("created_at")

  store        Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@index([subscriptionId])
  @@index([eventType])
  @@map("subscription_history")
}

model BillingRecord {
  id              Int      @id @default(autoincrement())
  storeId         Int      @map("store_id")
  subscriptionId  Int      @map("subscription_id")
  receiptId       Int?     @map("receipt_id") // FK to PaymentReceipt if paid via receipt
  planId          Int      @map("plan_id")
  planName        String   @map("plan_name")
  billingPeriod   String   @map("billing_period") // MONTHLY, QUARTERLY, SEMI_ANNUAL, ANNUAL
  amount          Int      // COP charged
  prorationCredit Int      @default(0) @map("proration_credit")
  netAmount       Int      @map("net_amount") // amount - prorationCredit
  status          String   @default("PAID") // PAID, PENDING, FAILED
  paymentMethod   String?  @map("payment_method")
  periodStart     DateTime @map("period_start")
  periodEnd       DateTime @map("period_end")
  notes           String?
  createdAt       DateTime @default(now()) @map("created_at")

  store        Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  subscription Subscription   @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  receipt     PaymentReceipt? @relation(fields: [receiptId], references: [id], onDelete: SetNull)

  @@index([storeId])
  @@index([subscriptionId])
  @@index([receiptId])
  @@map("billing_records")
}

model PaymentReceipt {
  id             Int       @id @default(autoincrement())
  subscriptionId Int       @map("subscription_id")
  storeId        Int       @map("store_id")
  fileName       String    @map("file_name")
  fileSize       Int       @map("file_size")
  fileType       String    @map("file_type")
  fileData       String    @map("file_data")
  amount         Int
  reference      String?
  paymentMethod  String    @default("OTHER") @map("payment_method")
  notes          String?
  status         String    @default("PENDING")
  reviewedBy     String?   @map("reviewed_by")
  reviewNotes    String?   @map("review_notes")
  reviewedAt     DateTime? @map("reviewed_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  store        Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  billingRecords BillingRecord[]

  @@index([subscriptionId])
  @@index([storeId, status])
  @@map("payment_receipts")
}

// ----------------------------------------------
// CONTEXTO: IMPUESTOS Y TRIBUTACION (DIAN)
// ----------------------------------------------

model TaxRate {
  id          Int      @id @default(autoincrement())
  storeId     Int      @map("store_id")
  name        String
  code        String
  rateType    String   @map("rate_type")
  rate        Int
  applyTo     String   @default("PRODUCT")
  category    String   @default("SALES_TAX")
  isActive    Boolean  @default(true) @map("is_active")
  isDefault   Boolean  @default(false) @map("is_default")
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt

  store     Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  products  Product[]

  @@unique([storeId, code])
  @@map("tax_rates")
}

// ----------------------------------------------
// CONTEXTO: FACTURACION ELECTRONICA (DIAN)
// ----------------------------------------------

model Invoice {
  id              Int      @id @default(autoincrement())
  storeId         Int      @map("store_id")
  orderId         Int      @unique @map("order_id")
  prefix          String   @default("FE")
  consecutive     Int
  resolutionNumber String? @map("resolution_number")
  resolutionDate  DateTime? @map("resolution_date")
  startDate       DateTime? @map("start_date")
  endDate         DateTime? @map("end_date")
  startNumber     Int?     @map("start_number")
  endNumber       Int?     @map("end_number")
  customerNit     String?  @map("customer_nit")
  customerName    String?  @map("customer_name")
  customerAddress String?  @map("customer_address")
  customerPhone   String?  @map("customer_phone")
  customerEmail   String?  @map("customer_email")
  customerRegime  String?  @map("customer_regime")
  customerType    String?  @map("customer_type")
  subtotalBase    Int      @map("subtotal_base")
  taxExemptAmount Int      @default(0) @map("tax_exempt_amount")
  taxBreakdown    String?  @map("tax_breakdown")
  totalTaxAmount  Int      @default(0) @map("total_tax_amount")
  totalWithTax    Int      @map("total_with_tax")
  discountAmount  Int      @default(0) @map("discount_amount")
  tipAmount       Int      @default(0) @map("tip_amount")
  grandTotal      Int      @map("grand_total")
  paymentMethod   String?  @map("payment_method")
  paymentNotes    String?  @map("payment_notes")
  cufe            String?
  qrCode          String?  @map("qr_code")
  xmlContent      String?  @map("xml_content")
  notes           String?
  status          String   @default("DRAFT")
  dianResponse    String?  @map("dian_response")
  dianErrorCode   String?  @map("dian_error_code")
  sentAt          DateTime? @map("sent_at")
  validatedAt     DateTime? @map("validated_at")
  emailedAt       DateTime? @map("emailed_at")
  testMode        Boolean  @default(true) @map("test_mode")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  creditNotes         CreditNote[]
  contingencyInvoices ContingencyInvoice[]

  @@unique([storeId, prefix, consecutive])
  @@index([storeId, createdAt])
  @@index([storeId, status])
  @@map("invoices")
}

model CreditNote {
  id                Int       @id @default(autoincrement())
  storeId           Int       @map("store_id")
  invoiceId         Int?      @map("invoice_id")
  prefix            String    @default("NC")
  consecutive       Int
  resolutionNumber  String?   @map("resolution_number")
  resolutionDate    DateTime? @map("resolution_date")
  startDate         DateTime? @map("start_date")
  endDate           DateTime? @map("end_date")
  startNumber       Int?      @map("start_number")
  endNumber         Int?      @map("end_number")
  noteType          String    @default("CREDIT")
  concept           String    @map("concept")
  description       String?
  customerNit       String?   @map("customer_nit")
  customerName      String?   @map("customer_name")
  customerEmail     String?   @map("customer_email")
  customerPhone     String?   @map("customer_phone")
  customerAddress   String?   @map("customer_address")
  customerRegime    String?   @map("customer_regime")
  customerType      String?   @map("customer_type")
  subtotalBase      Int       @default(0) @map("subtotal_base")
  taxExemptAmount   Int       @default(0) @map("tax_exempt_amount")
  taxBreakdown      String?   @map("tax_breakdown")
  totalTaxAmount    Int       @default(0) @map("total_tax_amount")
  totalWithTax      Int       @map("total_with_tax")
  discountAmount    Int       @default(0) @map("discount_amount")
  grandTotal        Int       @map("grand_total")
  cufe              String?
  qrCode            String?   @map("qr_code")
  xmlContent        String?   @map("xml_content")
  referencedInvoiceId String?  @map("referenced_invoice_id")
  referencedPrefix   String?  @map("referenced_prefix")
  referencedConsec   Int?     @map("referenced_consec")
  status            String    @default("DRAFT")
  dianResponse      String?   @map("dian_response")
  sentAt            DateTime? @map("sent_at")
  validatedAt       DateTime? @map("validated_at")
  emailedAt         DateTime? @map("emailed_at")
  testMode          Boolean   @default(true) @map("test_mode")
  notes             String?
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt

  store    Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  invoice  Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@unique([storeId, prefix, consecutive])
  @@index([storeId])
  @@index([invoiceId])
  @@map("credit_notes")
}

model ContingencyInvoice {
  id                Int       @id @default(autoincrement())
  storeId           Int       @map("store_id")
  invoiceId         Int?      @map("invoice_id")
  prefix            String    @default("FC")
  consecutive       Int
  contingencyType   String    @default("04")
  reason            String?
  customerNit       String?   @map("customer_nit")
  customerName      String?   @map("customer_name")
  customerEmail     String?   @map("customer_email")
  customerPhone     String?   @map("customer_phone")
  customerAddress   String?   @map("customer_address")
  customerRegime    String?   @map("customer_regime")
  customerType      String?   @map("customer_type")
  subtotalBase      Int       @default(0) @map("subtotal_base")
  taxExemptAmount   Int       @default(0) @map("tax_exempt_amount")
  taxBreakdown      String?   @map("tax_breakdown")
  totalTaxAmount    Int       @default(0) @map("total_tax_amount")
  totalWithTax      Int       @map("total_with_tax")
  discountAmount    Int       @default(0) @map("discount_amount")
  grandTotal        Int       @map("grand_total")
  originalCufe      String?   @map("original_cufe")
  originalCufeQR    String?   @map("original_cufe_qr")
  contingencyCufe   String?   @map("contingency_cufe")
  xmlContent        String?   @map("xml_content")
  status            String    @default("DRAFT")
  dianResponse      String?   @map("dian_response")
  contingencyStart  DateTime  @default(now()) @map("contingency_start")
  contingencyEnd    DateTime? @map("contingency_end")
  retransmittedAt   DateTime? @map("retransmitted_at")
  testMode          Boolean   @default(true) @map("test_mode")
  notes             String?
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt

  store    Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  invoice  Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@unique([storeId, prefix, consecutive])
  @@index([storeId])
  @@index([invoiceId])
  @@map("contingency_invoices")
}

// ----------------------------------------------
// CONTEXTO: INVENTARIO Y CATALOGO
// ----------------------------------------------

model Category {
  id        Int      @id @default(autoincrement())
  storeId   Int      @map("store_id")
  name      String
  icon      String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt

  store    Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([storeId, name])
  @@map("categories")
}

model Product {
  id            Int      @id @default(autoincrement())
  storeId       Int      @map("store_id")
  categoryId    Int?     @map("category_id")
  providerId    Int?     @map("provider_id")
  taxRateId     Int?     @map("tax_rate_id")
  sku           String?
  barcode       String?
  name          String
  description   String?
  imgUrl        String?  @map("img_url")
  invima        String?
  costPrice     Int      @default(0) @map("cost_price")
  salePrice     Int
  commission    Int      @default(0) @map("commission")
  currentStock  Int      @default(0) @map("current_stock")
  minStock      Int      @default(5) @map("min_stock")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt

  store              Store                @relation(fields: [storeId], references: [id], onDelete: Cascade)
  category           Category?            @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  provider           Provider?            @relation(fields: [providerId], references: [id], onDelete: SetNull)
  taxRate            TaxRate?             @relation(fields: [taxRateId], references: [id], onDelete: SetNull)
  inventoryMovements InventoryMovement[]
  orderItems         OrderItem[]
  comandaItems       ComandaItem[]
  purchaseItems      PurchaseItem[]
  quotationItems     QuotationItem[]
  costHistories      CostHistory[]

  @@index([categoryId])
  @@index([providerId])
  @@index([taxRateId])
  @@unique([storeId, name])
  @@map("products")
}

model InventoryMovement {
  id           Int      @id @default(autoincrement())
  storeId      Int      @map("store_id")
  productId    Int      @map("product_id")
  quantity     Int
  movementType String   @map("movement_type")
  referenceId  Int?     @map("reference_id")
  notes        String?
  createdAt    DateTime @default(now()) @map("created_at")

  store   Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  order   Order?  @relation("OrderMovements", fields: [referenceId], references: [id], onDelete: Cascade)

  @@index([storeId, productId, createdAt])
  @@index([referenceId])
  @@map("inventory_movements")
}

model Purchase {
  id               Int       @id @default(autoincrement())
  storeId          Int       @map("store_id")
  providerId       Int?      @map("provider_id")
  invoiceNumber    String?   @map("invoice_number")
  documentType     String    @default("FACTURA_COMPRA") @map("document_type") // FACTURA_COMPRA, NOTA_CREDITO, NOTA_DEBITO, RECIBO_CAJA, ORDEN_COMPRA
  consecutiveNumber String?   @map("consecutive_number")
  date             DateTime  @default(now())
  dueDate          DateTime? @map("due_date")
  paymentTerms     String    @default("CONTADO") @map("payment_terms") // CONTADO, CREDITO_30, CREDITO_60, CREDITO_90
  paymentStatus    String    @default("PENDING") @map("payment_status") // PENDING, PARTIAL, PAID
  amountPaid       Int       @default(0) @map("amount_paid")
  subtotal         Int       @default(0)
  totalIva         Int       @default(0) @map("total_iva")
  totalReteFuente  Int       @default(0) @map("total_rete_fuente")
  totalReteIca     Int       @default(0) @map("total_rete_ica")
  totalReteIva     Int       @default(0) @map("total_rete_iva")
  totalDiscount    Int       @default(0) @map("total_discount")
  notes            String?
  total            Int       @default(0)
  status           String    @default("COMPLETED") // PENDING, APPROVED, RECEIVED, PARTIAL, COMPLETED, CANCELLED
  createdById      Int?      @map("created_by_id")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt

  store            Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  provider         Provider?         @relation(fields: [providerId], references: [id], onDelete: SetNull)
  purchaseItems    PurchaseItem[]
  purchasePayments PurchasePayment[]
  costHistoryRecords  CostHistory[]
  createdBy        User?             @relation("UserPurchases", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([storeId])
  @@index([providerId])
  @@index([storeId, date])
  @@index([status])
  @@map("purchases")
}

model PurchaseItem {
  id               Int      @id @default(autoincrement())
  purchaseId       Int      @map("purchase_id")
  productId        Int      @map("product_id")
  quantity         Int
  returnedQuantity Int      @default(0) @map("returned_quantity")
  unitCost         Int      @map("unit_cost")
  ivaRate          Int      @default(0) @map("iva_rate") // IVA % for this item (0 = exento, 19, 5, etc.)
  ivaAmount        Int      @default(0) @map("iva_amount")
  discountAmount   Int      @default(0) @map("discount_amount")
  lotNumber        String?  @map("lot_number")
  expiryDate       DateTime? @map("expiry_date")
  manufacturingDate DateTime? @map("manufacturing_date")
  total            Int      // unitCost * quantity + ivaAmount - discountAmount

  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([purchaseId])
  @@index([productId])
  @@map("purchase_items")
}

model Provider {
  id           Int      @id @default(autoincrement())
  storeId      Int      @map("store_id")
  name         String
  contactName  String?  @map("contact_name")
  phone        String?
  email        String?
  address      String?
  city         String?
  nit          String?
  dv           String?                          // Dígito de verificación
  regime       String   @default("NO_RESPONSABLE") // RESPONSABLE, NO_RESPONSABLE, SIMPLIFICADO, GRAN_CONTRIBUTUYENTE
  autoretainer Boolean  @default(false) @map("autoretainer") // Autoretenedor de IVA
  paymentTerms String   @default("CONTADO") @map("payment_terms") // CONTADO, CREDITO_30, CREDITO_60, CREDITO_90
  creditLimit  Int      @default(0) @map("credit_limit")
  totalDebt    Int      @default(0) @map("total_debt")
  totalPurchases Int     @default(0) @map("total_purchases")
  notes        String?
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt

  store     Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  products  Product[]
  purchases Purchase[]

  @@unique([storeId, name])
  @@index([storeId, nit])
  @@map("providers")
}

// ----------------------------------------------
// CONTEXTO: PAGOS A PROVEEDORES
// ----------------------------------------------

model PurchasePayment {
  id            Int      @id @default(autoincrement())
  purchaseId    Int      @map("purchase_id")
  storeId       Int      @map("store_id")
  amount        Int
  paymentMethod String   @default("CASH") @map("payment_method") // CASH, TRANSFER, CHECK, CARD
  reference     String?
  notes         String?
  createdById   Int?     @map("created_by_id")
  createdAt     DateTime @default(now()) @map("created_at")

  purchase  Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdBy User?    @relation("UserPurchasePayments", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([purchaseId])
  @@index([storeId])
  @@map("purchase_payments")
}

// ----------------------------------------------
// CONTEXTO: HISTORIAL DE COSTOS POR PRODUCTO
// ----------------------------------------------

model CostHistory {
  id           Int      @id @default(autoincrement())
  productId    Int      @map("product_id")
  storeId      Int      @map("store_id")
  previousCost Int      @map("previous_cost")
  newCost      Int      @map("new_cost")
  purchaseId   Int?     @map("purchase_id")
  reason       String?  // PURCHASE, MANUAL, ADJUSTMENT
  createdAt    DateTime @default(now()) @map("created_at")

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  store    Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  purchase Purchase? @relation(fields: [purchaseId], references: [id], onDelete: SetNull)

  @@index([productId, createdAt])
  @@index([storeId])
  @@map("cost_histories")
}

// ----------------------------------------------
// CONTEXTO: VENTAS Y COMERCIO
// ----------------------------------------------

model Customer {
  id              Int      @id @default(autoincrement())
  storeId         Int      @map("store_id")
  name            String
  phone           String?
  email           String?
  nit             String?
  documentType    String?  @map("document_type")
  address         String?
  regime          String?
  totalDebt       Int      @default(0) @map("total_debt")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt

  store          Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  orders         Order[]
  tableSessions  TableSession[]
  quotations     Quotation[]

  @@index([storeId])
  @@map("customers")
}

model Order {
  id             Int            @id @default(autoincrement())
  storeId        Int            @map("store_id")
  customerId     Int?           @map("customer_id")
  tableSessionId Int?           @map("table_session_id")
  cashRegisterId Int?           @map("cash_register_id")
  orderNumber    String         @map("order_number")
  subtotal       Int
  taxAmount      Int            @default(0) @map("tax_amount")
  taxBreakdown   String?        @map("tax_breakdown")
  tipAmount      Int            @default(0) @map("tip_amount")
  discountAmount Int            @default(0) @map("discount_amount")
  discountType   String         @default("NONE") @map("discount_type")
  discountReason String?        @map("discount_reason")
  total          Int
  status         String         @default("COMPLETED")
  paymentMethod  String         @default("CASH") @map("payment_method")
  notes          String?
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt

  store              Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer           Customer?           @relation(fields: [customerId], references: [id], onDelete: SetNull)
  tableSession       TableSession?       @relation(fields: [tableSessionId], references: [id], onDelete: SetNull)
  cashRegister       CashRegister?       @relation(fields: [cashRegisterId], references: [id], onDelete: SetNull)
  orderItems         OrderItem[]
  inventoryMovements InventoryMovement[] @relation("OrderMovements")
  invoice            Invoice?

  @@unique([storeId, orderNumber])
  @@index([storeId, createdAt])
  @@index([storeId, status])
  @@index([customerId])
  @@index([tableSessionId])
  @@index([cashRegisterId])
  @@map("orders")
}

model OrderItem {
  id               Int      @id @default(autoincrement())
  orderId          Int      @map("order_id")
  productId        Int?     @map("product_id")
  serviceId        Int?     @map("service_id")
  quantity         Int
  returnedQuantity Int      @default(0) @map("returned_quantity")
  unitPrice        Int      @map("unit_price")
  totalRow         Int      @map("total_row")
  taxCode          String?  @map("tax_code")
  taxRate          Int      @default(0) @map("tax_rate")
  taxAmount        Int      @default(0) @map("tax_amount")
  taxBase          Int      @default(0) @map("tax_base")
  notes            String?

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  service Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
  @@index([serviceId])
  @@map("order_items")
}

// ----------------------------------------------
// CONTEXTO: MESAS Y COMANDAS (RESTAURANTE/BAR)
// ----------------------------------------------

model BarTable {
  id        Int      @id @default(autoincrement())
  storeId   Int      @map("store_id")
  number    Int
  name      String?
  capacity  Int      @default(4)
  zone      String   @default("PRINCIPAL")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt

  store          Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  tableSessions  TableSession[]

  @@unique([storeId, number])
  @@map("bar_tables")
}

model TableSession {
  id           Int      @id @default(autoincrement())
  storeId      Int      @map("store_id")
  barTableId   Int      @map("bar_table_id")
  customerId   Int?     @map("customer_id")
  guests       Int      @default(1)
  startedAt    DateTime @default(now()) @map("started_at")
  closedAt     DateTime? @map("closed_at")
  status       String   @default("OPEN")
  notes        String?

  store       Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  barTable    BarTable     @relation(fields: [barTableId], references: [id], onDelete: Cascade)
  customer    Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  orders      Order[]
  comandaItems ComandaItem[]

  @@index([storeId])
  @@index([barTableId])
  @@index([customerId])
  @@map("table_sessions")
}

model ComandaItem {
  id             Int      @id @default(autoincrement())
  storeId        Int      @map("store_id")
  tableSessionId Int      @map("table_session_id")
  productId      Int?     @map("product_id")
  serviceId      Int?     @map("service_id")
  productName    String   @map("product_name")
  quantity       Int
  unitPrice      Int      @map("unit_price")
  total          Int
  notes          String?
  status         String   @default("PENDING")
  createdAt      DateTime @default(now()) @map("created_at")

  store        Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  tableSession TableSession  @relation(fields: [tableSessionId], references: [id], onDelete: Cascade)
  product      Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)
  service      Service?      @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([storeId])
  @@index([tableSessionId])
  @@index([productId])
  @@index([serviceId])
  @@map("comanda_items")
}

// ----------------------------------------------
// CONTEXTO: CONTABILIDAD Y FINANZAS
// ----------------------------------------------

model LedgerAccount {
  id        Int     @id @default(autoincrement())
  storeId   Int     @map("store_id")
  name      String
  type      String
  isDefault Boolean @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt

  store          Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  journalEntries JournalEntry[]

  @@index([storeId])
  @@map("ledger_accounts")
}

model JournalEntry {
  id              Int      @id @default(autoincrement())
  storeId         Int      @map("store_id")
  ledgerAccountId Int      @map("ledger_account_id")
  amount          Int
  direction       String
  description     String?
  referenceType   String?  @map("reference_type")
  referenceId     Int?     @map("reference_id")
  createdAt       DateTime @default(now()) @map("created_at")

  store         Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  ledgerAccount LedgerAccount @relation(fields: [ledgerAccountId], references: [id], onDelete: Cascade)

  @@index([storeId, ledgerAccountId])
  @@map("journal_entries")
}

// ----------------------------------------------
// CONTEXTO: SERVICIOS DEL BAR
// ----------------------------------------------

model Service {
  id          Int      @id @default(autoincrement())
  storeId     Int      @map("store_id")
  name        String
  description String?
  price       Int      @default(0)
  icon        String   @default("Star")
  unit        String   @default("servicio")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt

  store              Store                @relation(fields: [storeId], references: [id], onDelete: Cascade)
  serviceTransactions ServiceTransaction[]
  comandaItems        ComandaItem[]
  orderItems         OrderItem[]

  @@unique([storeId, name])
  @@map("services")
}

model ServiceTransaction {
  id           Int      @id @default(autoincrement())
  storeId      Int      @map("store_id")
  serviceId    Int      @map("service_id")
  quantity     Int      @default(1)
  unitPrice    Int      @map("unit_price")
  totalAmount  Int      @map("total_amount")
  notes        String?
  status       String   @default("COMPLETED")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt

  store   Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@index([serviceId])
  @@map("service_transactions")
}

// ----------------------------------------------
// CONTEXTO: CAJA REGISTRADORA
// ----------------------------------------------

model CashRegister {
  id              Int       @id @default(autoincrement())
  storeId         Int       @map("store_id")
  userId          Int       @map("user_id")
  openedAt        DateTime  @default(now()) @map("opened_at")
  closedAt        DateTime? @map("closed_at")
  openingBalance  Int       @default(0) @map("opening_balance")
  closingBalance  Int?      @map("closing_balance")
  expectedCash    Int?      @map("expected_cash")
  difference      Int?      @map("difference")
  status          String    @default("OPEN")
  countBreakdown  String?   @map("count_breakdown")
  notes           String?

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Restrict)
  orders Order[]

  @@index([storeId, status])
  @@index([userId])
  @@map("cash_registers")
}

// ----------------------------------------------
// CONTEXTO: GASTOS OPERACIONALES
// ----------------------------------------------

model Expense {
  id          Int      @id @default(autoincrement())
  storeId     Int      @map("store_id")
  category    String
  description String
  amount      Int
  date        DateTime @default(now())
  notes       String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, date])
  @@map("expenses")
}

// ----------------------------------------------
// CONTEXTO: ROLES Y PERMISOS (SaaS)
// ----------------------------------------------

model Role {
  id          Int      @id @default(autoincrement())
  storeId     Int      @map("store_id")
  name        String
  description String?
  permissions String   @default("{}") @map("permissions")
  isDefault   Boolean  @default(false) @map("is_default")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt

  store     Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  employees Employee[]

  @@unique([storeId, name])
  @@map("roles")
}

// ----------------------------------------------
// CONTEXTO: EMPLEADOS (SaaS)
// ----------------------------------------------

model Employee {
  id          Int      @id @default(autoincrement())
  storeId     Int      @map("store_id")
  userId      Int      @unique @map("user_id")
  roleId      Int?     @map("role_id")
  position    String?
  permissions String   @default("{}") @map("permissions")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user  User  @relation("EmployeeStore", fields: [userId], references: [id], onDelete: Restrict)
  role  Role? @relation(fields: [roleId], references: [id], onDelete: SetNull)

  @@index([storeId])
  @@index([roleId])
  @@map("employees")
}

// ----------------------------------------------
// CONTEXTO: COTIZACIONES
// ----------------------------------------------

model Quotation {
  id                Int       @id @default(autoincrement())
  storeId           Int       @map("store_id")
  customerId        Int?      @map("customer_id")
  quotationNumber   String    @map("quotation_number")
  customerName      String?   @map("customer_name")
  customerNit       String?   @map("customer_nit")
  customerEmail     String?   @map("customer_email")
  customerPhone     String?   @map("customer_phone")
  customerAddress   String?   @map("customer_address")
  subtotal          Int       @default(0)
  taxAmount         Int       @default(0) @map("tax_amount")
  taxBreakdown      String?   @map("tax_breakdown")
  discountAmount    Int       @default(0) @map("discount_amount")
  discountType      String    @default("NONE") @map("discount_type")
  total             Int       @default(0)
  validUntil        DateTime? @map("valid_until")
  notes             String?
  status            String    @default("ACTIVE")
  convertedToOrderId Int?     @map("converted_to_order_id")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt

  store    Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items    QuotationItem[]

  @@unique([storeId, quotationNumber])
  @@index([storeId])
  @@index([customerId])
  @@map("quotations")
}

model QuotationItem {
  id            Int      @id @default(autoincrement())
  quotationId   Int      @map("quotation_id")
  productId     Int?     @map("product_id")
  productName   String   @map("product_name")
  quantity      Int
  unitPrice     Int      @map("unit_price")
  totalRow      Int      @map("total_row")
  taxCode       String?  @map("tax_code")
  taxRate       Int      @default(0) @map("tax_rate")
  taxAmount     Int      @default(0) @map("tax_amount")
  taxBase       Int      @default(0) @map("tax_base")
  notes         String?

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  product   Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([quotationId])
  @@index([productId])
  @@map("quotation_items")
}

// ----------------------------------------------
// CONTEXTO: CONFIGURACIÓN DEL SISTEMA (Global)
// ----------------------------------------------

model SystemSetting {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String   @default("")
  updatedAt DateTime @updatedAt

  @@map("system_settings")
}
