generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled connection (Neon `-pooler` host with ?pgbouncer=true, or a local/VPS Postgres).
  url       = env("DATABASE_URL")
  // Unpooled connection used by `prisma migrate` / `db push`. On a self-hosted
  // Postgres this is the same value as DATABASE_URL; on Neon it is the direct
  // (non-pooler) connection string.
  directUrl = env("DIRECT_URL")
}

// ╔══════════════════════════════════════════════════════════════════╗
// ║  SEBWEN POS — PostgreSQL (dev + prod)                            ║
// ║  ─────────────────────────────────────────────────────────────  ║
// ║  DEV:  local Postgres — `docker compose up -d postgres`         ║
// ║        DATABASE_URL = DIRECT_URL = the local container URL      ║
// ║  PROD: Neon (managed) now, self-hosted VPS Postgres later.      ║
// ║        Neon → DATABASE_URL = pooled, DIRECT_URL = direct.       ║
// ║        VPS  → both URLs identical.                              ║
// ║                                                                  ║
// ║  Schema changes: `npm run db:migrate` (dev) generates a         ║
// ║  migration in prisma/migrations/; `prisma migrate deploy`        ║
// ║  applies them in CI/prod. Do NOT use `db push` against prod.    ║
// ╚══════════════════════════════════════════════════════════════════╝

// ----------------------------------------------
// CONTEXTO: HISTORIAL DE EVENTOS DEL SISTEMA (SaaS Analytics)
// ----------------------------------------------

model StoreEventLog {
  id            Int      @id @default(autoincrement())
  storeId       Int      @map("store_id")
  eventType     String   @map("event_type")
  // STORE_CREATED, STORE_ACTIVATED, TRIAL_STARTED, TRIAL_ENDED,
  // SUBSCRIPTION_ACTIVE, SUBSCRIPTION_PAST_DUE, SUBSCRIPTION_CANCELLED,
  // SUBSCRIPTION_REACTIVATED, PLAN_UPGRADED, PLAN_DOWNGRADED,
  // BRANCH_CREATED, STORE_DELETED
  previousValue String?  @map("previous_value")
  newValue      String?  @map("new_value")
  metadata      String   @default("{}") @map("metadata")
  createdAt     DateTime @default(now()) @map("created_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, eventType])
  @@index([eventType, createdAt])
  @@index([createdAt])
  @@map("store_event_logs")
}

// ----------------------------------------------
// CONTEXTO: IDENTIDAD Y ACCESO
// ----------------------------------------------

model User {
  id               Int      @id @default(autoincrement())
  cedula           String   @unique
  phone            String?
  email            String?
  passwordHash     String
  fullName         String?  @map("full_name")
  role             String   @default("OWNER") // SUPER_ADMIN, OWNER, EMPLOYEE
  securityQuestion String?  @map("security_question")
  securityAnswer   String?  @map("security_answer")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt

  store    Store?    @relation("UserStore")
  employee Employee? @relation("EmployeeStore")

  otpTokens              OtpToken[]
  cashRegisters          CashRegister[]
  purchases              Purchase[]        @relation("UserPurchases")
  purchasePaymentRecords PurchasePayment[] @relation("UserPurchasePayments")
  assignedLeads          Lead[]            @relation("LeadAssignedTo")
  leadDocumentReviews    LeadDocument[]    @relation("LeadDocumentReviewer")
  leadActivities         LeadActivity[]    @relation("LeadActivityCreator")

  @@map("users")
}

// ----------------------------------------------
// CONTEXTO: REVOCACION DE TOKENS (Token Blacklist)
// ----------------------------------------------

model RevokedToken {
  id        Int      @id @default(autoincrement())
  tokenJti  String   @unique @map("token_jti") // Unique token identifier (version.payloadHash)
  userId    Int      @map("user_id")
  reason    String   @default("LOGOUT") // LOGOUT, PASSWORD_CHANGE, ACCOUNT_DISABLED, SECURITY_BREACH
  expiresAt DateTime @map("expires_at") // When the token would have expired — for cleanup
  createdAt DateTime @default(now()) @map("created_at")

  @@index([tokenJti])
  @@index([expiresAt]) // For cleanup cron: DELETE WHERE expiresAt < NOW
  @@index([userId])
  @@map("revoked_tokens")
}

// ----------------------------------------------
// CONTEXTO: AUDITORIA (Audit Trail)
// ----------------------------------------------

model AuditLog {
  id        Int      @id @default(autoincrement())
  storeId   Int?     @map("store_id")
  userId    Int?     @map("user_id")
  action    String // CREATE, UPDATE, DELETE, LOGIN, LOGOUT, CANCEL, ADJUST, RETURN, etc.
  entity    String // Order, Invoice, Product, Customer, InventoryMovement, etc.
  entityId  Int?     @map("entity_id") // ID of the affected entity
  oldValue  String?  @map("old_value") // JSON of previous state (for updates/deletes)
  newValue  String?  @map("new_value") // JSON of new state (for creates/updates)
  ipAddress String?  @map("ip_address") // Client IP
  userAgent String?  @map("user_agent") // Client browser/app
  metadata  String   @default("{}") @map("metadata") // Extra context (discount reason, payment method, etc.)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([storeId, entity, createdAt])
  @@index([storeId, action, createdAt])
  @@index([userId, createdAt])
  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ----------------------------------------------
// CONTEXTO: OTP (One-Time Password) para WhatsApp
// ----------------------------------------------

model OtpToken {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  phone     String
  code      String
  verified  Boolean  @default(false)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("otp_tokens")
}

model Store {
  id                         Int       @id @default(autoincrement())
  userId                     Int       @unique @map("user_id")
  name                       String
  legalName                  String?   @map("legal_name")
  nit                        String?
  address                    String?
  phone                      String?
  currencyCode               String    @default("COP") @map("currency_code")
  countryCode                String?   @map("country_code")
  // Días de antigüedad sin pagar para que una deuda de CxC se considere "vencida" (Índice de Morosidad)
  debtOverdueDays            Int       @default(30) @map("debt_overdue_days")
  // DIAN Resolution (Facturación Electrónica)
  invoicePrefix              String?   @map("invoice_prefix")
  resolutionNumber           String?   @map("resolution_number")
  resolutionStartDate        DateTime? @map("resolution_start_date")
  resolutionEndDate          DateTime? @map("resolution_end_date")
  resolutionStartNumber      Int?      @map("resolution_start_number")
  resolutionEndNumber        Int?      @map("resolution_end_number")
  invoiceTestMode            Boolean   @default(true) @map("invoice_test_mode")
  // Facturación Electrónica Híbrida
  invoiceProvider            String    @default("NONE") @map("invoice_provider")
  invoiceEnabled             Boolean   @default(false) @map("invoice_enabled")
  certificateUploaded        Boolean   @default(false) @map("certificate_uploaded")
  certificatePassword        String?   @map("certificate_password")
  softwareId                 String?   @map("software_id")
  softwarePin                String?   @map("software_pin")
  providerConfig             String    @default("{}") @map("provider_config")
  // DIVIPOLA (código municipio DIAN)
  divipolaCode               String?   @map("divipola_code")
  cityName                   String?   @map("city_name")
  // Datos fiscales (capturados en el CRM legal durante el onboarding, ver Lead)
  taxRegime                  String?   @map("tax_regime")
  fiscalResponsibilities     String?   @map("fiscal_responsibilities")
  // Certificate management
  certUploadedAt             DateTime? @map("cert_uploaded_at")
  certExpiresAt              DateTime? @map("cert_expires_at")
  certSubject                String?   @map("cert_subject")
  // PTE (Proveedor Tecnológico Electrónico)
  connectionMode             String    @default("OFFLINE") @map("connection_mode")
  pteNit                     String?   @map("pte_nit")
  pteApiUrl                  String?   @map("pte_api_url")
  pteApiKey                  String?   @map("pte_api_key")
  electronicInvoicingEnabled Boolean   @default(false) @map("electronic_invoicing_enabled")
  // Sucursal / Branch support
  parentStoreId              Int?      @map("parent_store_id")
  // Tienda Virtual (public storefront)
  storeSlug                  String?   @unique @map("store_slug")
  storeDescription           String?   @map("store_description")
  storeWhatsapp              String?   @map("store_whatsapp")
  storeActive                Boolean   @default(false) @map("store_active")
  createdAt                  DateTime  @default(now()) @map("created_at")
  updatedAt                  DateTime  @updatedAt

  user                    User                     @relation("UserStore", fields: [userId], references: [id], onDelete: Restrict)
  parentStore             Store?                   @relation("StoreBranches", fields: [parentStoreId], references: [id])
  branches                Store[]                  @relation("StoreBranches")
  employees               Employee[]
  roles                   Role[]
  categories              Category[]
  products                Product[]
  inventoryMovements      InventoryMovement[]
  customers               Customer[]
  orders                  Order[]
  ledgerAccounts          LedgerAccount[]
  journalEntries          JournalEntry[]
  services                Service[]
  serviceTransactions     ServiceTransaction[]
  barTables               BarTable[]
  tableSessions           TableSession[]
  comandaItems            ComandaItem[]
  providers               Provider[]
  providerProductMappings ProviderProductMapping[]
  purchases               Purchase[]
  cashRegisters           CashRegister[]
  expenses                Expense[]
  taxRates                TaxRate[]
  invoices                Invoice[]
  creditNotes             CreditNote[]
  debitNotes              DebitNote[]
  contingencyInvoices     ContingencyInvoice[]
  quotations              Quotation[]
  subscription            Subscription?
  paymentReceipts         PaymentReceipt[]
  subscriptionHistories   SubscriptionHistory[]
  billingRecords          BillingRecord[]
  purchasePayments        PurchasePayment[]
  costHistories           CostHistory[]
  storeEventLogs          StoreEventLog[]
  wompiTransactions       WompiTransaction[]
  pushSubscriptions       PushSubscription[]
  customerPayments        CustomerPayment[]
  processedRequests       ProcessedRequest[]
  batches                 Batch[]

  @@map("stores")
}

// ----------------------------------------------
// CONTEXTO: PLANES Y SUSCRIPCIONES (SaaS)
// ----------------------------------------------

model Plan {
  id           Int      @id @default(autoincrement())
  name         String
  description  String?
  price        Int
  maxStores    Int      @default(1) @map("max_stores")
  maxEmployees Int      @default(5) @map("max_employees")
  maxProducts  Int      @default(100) @map("max_products")
  features     String   @default("{}") @map("features")
  sortOrder    Int      @default(0) @map("sort_order")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt

  subscriptions                 Subscription[]
  subscriptionHistoriesPrevious SubscriptionHistory[] @relation("HistoryPreviousPlan")
  subscriptionHistoriesNew      SubscriptionHistory[] @relation("HistoryNewPlan")
  billingRecords                BillingRecord[]       @relation("BillingPlan")

  @@unique([name])
  @@map("plans")
}

model Subscription {
  id                    Int       @id @default(autoincrement())
  storeId               Int       @unique @map("store_id")
  planId                Int       @map("plan_id")
  status                String    @default("TRIAL")
  startDate             DateTime  @default(now()) @map("start_date")
  endDate               DateTime? @map("end_date")
  trialEndDate          DateTime? @map("trial_end_date")
  graceEndDate          DateTime? @map("grace_end_date")
  cancelReason          String?   @map("cancel_reason")
  billingPeriod         String    @default("MONTHLY") @map("billing_period")
  billingPrice          Int
  lastBilledAt          DateTime? @map("last_billed_at")
  nextBillingAt         DateTime? @map("next_billing_at")
  // ── Proration: credit for unused days when changing plans ──
  prorationCredit       Int       @default(0) @map("proration_credit")
  previousPlanId        Int?      @map("previous_plan_id")
  previousPlanName      String?   @map("previous_plan_name")
  proratedDaysRemaining Int       @default(0) @map("prorated_days_remaining")
  // ── Expiry alert tracking ──
  alertSentAt3d         DateTime? @map("alert_sent_at_3d")
  alertSentAt1d         DateTime? @map("alert_sent_at_1d")
  // Dunning: last-chance email sent the day before graceEndDate (PAST_DUE only)
  graceAlertSentAt      DateTime? @map("grace_alert_sent_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt

  store                 Store                 @relation(fields: [storeId], references: [id], onDelete: Cascade)
  plan                  Plan                  @relation(fields: [planId], references: [id], onDelete: Restrict)
  paymentReceipts       PaymentReceipt[]
  subscriptionHistories SubscriptionHistory[]
  billingRecords        BillingRecord[]
  wompiTransactions     WompiTransaction[]

  @@index([planId])
  @@map("subscriptions")
}

// ----------------------------------------------
// CONTEXTO: COMPROBANTES DE PAGO
// ----------------------------------------------

model SubscriptionHistory {
  id               Int      @id @default(autoincrement())
  storeId          Int      @map("store_id")
  subscriptionId   Int      @map("subscription_id")
  eventType        String   @map("event_type") // CREATED, RENEWED, CANCELLED, PLAN_CHANGED, EXPIRED, REACTIVATED, TRIAL_STARTED, GRACE_STARTED, BILLING_PERIOD_CHANGED
  previousStatus   String?  @map("previous_status")
  newStatus        String?  @map("new_status")
  previousPlanId   Int?     @map("previous_plan_id")
  newPlanId        Int?     @map("new_plan_id")
  previousPlanName String?  @map("previous_plan_name")
  newPlanName      String?  @map("new_plan_name")
  description      String?
  metadata         String   @default("{}") @map("metadata") // JSON with extra context
  createdAt        DateTime @default(now()) @map("created_at")

  store        Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  // M-10: FK references for plan history tracking (denormalized for historical integrity)
  previousPlan Plan?        @relation("HistoryPreviousPlan", fields: [previousPlanId], references: [id], onDelete: SetNull)
  newPlan      Plan?        @relation("HistoryNewPlan", fields: [newPlanId], references: [id], onDelete: SetNull)

  @@index([storeId])
  @@index([subscriptionId])
  @@index([eventType])
  @@map("subscription_history")
}

model BillingRecord {
  id              Int      @id @default(autoincrement())
  invoiceNumber   String   @unique @map("invoice_number") // e.g. "VF-0001"
  storeId         Int      @map("store_id")
  subscriptionId  Int      @map("subscription_id")
  receiptId       Int?     @map("receipt_id") // FK to PaymentReceipt if paid via receipt
  planId          Int      @map("plan_id")
  planName        String   @map("plan_name")
  billingPeriod   String   @map("billing_period") // MONTHLY, QUARTERLY, SEMI_ANNUAL, ANNUAL
  amount          Int // COP charged (subtotal)
  prorationCredit Int      @default(0) @map("proration_credit")
  netAmount       Int      @map("net_amount") // amount - prorationCredit
  status          String   @default("PAID") // PAID, PENDING, FAILED, VOIDED
  paymentMethod   String?  @map("payment_method")
  periodStart     DateTime @map("period_start")
  periodEnd       DateTime @map("period_end")
  notes           String?
  createdAt       DateTime @default(now()) @map("created_at")

  store        Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  subscription Subscription    @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  receipt      PaymentReceipt? @relation(fields: [receiptId], references: [id], onDelete: SetNull)
  // M-10: FK reference to plan (denormalized planName kept for historical records)
  plan         Plan            @relation("BillingPlan", fields: [planId], references: [id], onDelete: Restrict)

  @@index([storeId])
  @@index([subscriptionId])
  @@index([receiptId])
  @@map("billing_records")
}

// ----------------------------------------------
// CONTEXTO: CRM LEADS (solicitudes de prueba/cuenta)
// ----------------------------------------------

model Lead {
  id                     Int       @id @default(autoincrement())
  // ── Contacto primario (compat — ver también Contact para contactos adicionales) ──
  ownerFullName          String    @map("owner_full_name")
  ownerCedula            String    @map("owner_cedula")
  ownerEmail             String?   @map("owner_email")
  ownerPhone             String?   @map("owner_phone")
  ownerPassword          String?   @map("owner_password") // Hashed, solo se usa al crear la cuenta
  // ── Empresa ──
  storeName              String    @map("store_name")
  nit                    String
  legalName              String    @map("legal_name")
  businessType           String    @default("NATURAL") @map("business_type")
  storePhone             String?   @map("store_phone")
  department             String?   @map("department")
  cityName               String?   @map("city_name")
  address                String?   @map("address")
  hasCamaraComercio      Boolean   @default(false) @map("has_camara_comercio")
  registrationNumber     String?   @map("registration_number")
  // ── Datos fiscales (CRM legal — se copian a Store en la conversión) ──
  taxRegime              String?   @map("tax_regime") // Responsable de IVA, No Responsable, Régimen Simple...
  fiscalResponsibilities String?   @map("fiscal_responsibilities") // JSON array de códigos RUT casilla 53
  // ── Resolución DIAN (capturable antes de la conversión — mismo nombre que Store para copia directa) ──
  resolutionPrefix       String?   @map("resolution_prefix")
  resolutionNumber       String?   @map("resolution_number")
  resolutionStartDate    DateTime? @map("resolution_start_date")
  resolutionEndDate      DateTime? @map("resolution_end_date")
  resolutionStartNumber  Int?      @map("resolution_start_number")
  resolutionEndNumber    Int?      @map("resolution_end_number")
  // ── Documentos adjuntos (legacy — se está migrando a LeadDocument, ver abajo) ──
  rutFilePath            String?   @map("rut_file_path") // RUT/Documento tributario
  rutFileName            String?   @map("rut_file_name")
  rutFileSize            Int?      @map("rut_file_size")
  rutFileType            String?   @map("rut_file_type")
  camaraFilePath         String?   @map("camara_file_path") // Cámara de comercio
  camaraFileName         String?   @map("camara_file_name")
  camaraFileSize         Int?      @map("camara_file_size")
  camaraFileType         String?   @map("camara_file_type")
  // ── Pipeline CRM ──
  stage                  String    @default("LEAD") @map("stage")
  // LEAD, CONTACTADO, DOC_PENDIENTE, VALIDACION_LEGAL, CLIENTE_ACTIVO, RECHAZADO
  assignedToId           Int?      @map("assigned_to_id") // Asesor comercial responsable
  status                 String    @default("NEW") // legacy — NEW, CONTACTED, APPROVED, REJECTED, CONVERTED (ver stage)
  source                 String    @default("WEB") // WEB, WHATSAPP, REFERRAL
  notes                  String? // Notas del super admin
  reviewedBy             String?   @map("reviewed_by")
  reviewedAt             DateTime? @map("reviewed_at")
  convertedStoreId       Int?      @map("converted_store_id") // Store ID cuando se convierte en cuenta
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt

  // Asesor comercial (usuario Super Admin) responsable del lead — no es Employee,
  // que pertenece al staff de un tenant ya creado.
  assignedTo User?          @relation("LeadAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  contacts   Contact[]
  documents  LeadDocument[]
  activities LeadActivity[]

  @@index([status])
  @@index([stage])
  @@index([assignedToId])
  @@index([ownerCedula])
  @@index([nit])
  @@map("leads")
}

// ----------------------------------------------
// CONTEXTO: CRM — CONTACTOS ADICIONALES DEL LEAD
// ----------------------------------------------

model Contact {
  id        Int      @id @default(autoincrement())
  leadId    Int      @map("lead_id")
  fullName  String   @map("full_name")
  cedula    String?
  role      String   @default("OTRO") // REPRESENTANTE_LEGAL, CONTADOR, ENCARGADO, OTRO
  email     String?
  phone     String?
  isPrimary Boolean  @default(false) @map("is_primary")
  createdAt DateTime @default(now()) @map("created_at")

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@map("lead_contacts")
}

// ----------------------------------------------
// CONTEXTO: CRM — EXPEDIENTE LEGAL (documentos DIAN)
// ----------------------------------------------

model LeadDocument {
  id              Int       @id @default(autoincrement())
  leadId          Int       @map("lead_id")
  documentType    String    @map("document_type")
  // RUT, CAMARA_COMERCIO, CEDULA_REPRESENTANTE, RESOLUCION_DIAN
  filePath        String    @map("file_path")
  fileName        String    @map("file_name")
  fileSize        Int       @map("file_size")
  fileType        String    @map("file_type")
  status          String    @default("PENDING") @map("status") // PENDING, APPROVED, REJECTED
  rejectionReason String?   @map("rejection_reason")
  version         Int       @default(1)
  uploadedAt      DateTime  @default(now()) @map("uploaded_at")
  reviewedBy      Int?      @map("reviewed_by")
  reviewedAt      DateTime? @map("reviewed_at")

  lead     Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  reviewer User? @relation("LeadDocumentReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)

  @@index([leadId])
  @@index([leadId, documentType])
  @@map("lead_documents")
}

// ----------------------------------------------
// CONTEXTO: CRM — ACTIVIDAD Y BITÁCORA COMERCIAL
// ----------------------------------------------

model LeadActivity {
  id          Int       @id @default(autoincrement())
  leadId      Int       @map("lead_id")
  type        String // NOTE, CALL, TASK, WHATSAPP, STAGE_CHANGE, DOCUMENT_EVENT
  title       String
  description String?
  dueDate     DateTime? @map("due_date")
  completedAt DateTime? @map("completed_at")
  createdById Int?      @map("created_by_id") // null = generado por el sistema
  createdAt   DateTime  @default(now()) @map("created_at")

  lead      Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  createdBy User? @relation("LeadActivityCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([leadId, createdAt])
  @@map("lead_activities")
}

model PaymentReceipt {
  id             Int       @id @default(autoincrement())
  subscriptionId Int       @map("subscription_id")
  storeId        Int       @map("store_id")
  fileName       String    @map("file_name")
  fileSize       Int       @map("file_size")
  fileType       String    @map("file_type")
  fileData       String?   @map("file_data") // Deprecated: kept for migration compat, new records use filePath
  filePath       String?   @map("file_path") // Relative path in /uploads/ (e.g., "receipts/2024/01/abc-123.png")
  amount         Int
  reference      String?
  paymentMethod  String    @default("OTHER") @map("payment_method")
  notes          String?
  status         String    @default("PENDING")
  reviewedBy     String?   @map("reviewed_by")
  reviewNotes    String?   @map("review_notes")
  reviewedAt     DateTime? @map("reviewed_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt

  subscription     Subscription      @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  store            Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  billingRecords   BillingRecord[]
  wompiTransaction WompiTransaction?

  @@index([subscriptionId])
  @@index([storeId, status])
  @@map("payment_receipts")
}

// ----------------------------------------------
// CONTEXTO: IMPUESTOS Y TRIBUTACION (DIAN)
// ----------------------------------------------

model TaxRate {
  id          Int      @id @default(autoincrement())
  storeId     Int      @map("store_id")
  name        String
  code        String
  rateType    String   @map("rate_type")
  rate        Int
  applyTo     String   @default("PRODUCT")
  category    String   @default("SALES_TAX")
  isActive    Boolean  @default(true) @map("is_active")
  isDefault   Boolean  @default(false) @map("is_default")
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt

  store    Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([storeId, code])
  @@map("tax_rates")
}

// ----------------------------------------------
// CONTEXTO: FACTURACION ELECTRONICA (DIAN)
// ----------------------------------------------

model Invoice {
  id               Int       @id @default(autoincrement())
  storeId          Int       @map("store_id")
  orderId          Int       @unique @map("order_id")
  prefix           String    @default("FE")
  consecutive      Int
  resolutionNumber String?   @map("resolution_number")
  resolutionDate   DateTime? @map("resolution_date")
  startDate        DateTime? @map("start_date")
  endDate          DateTime? @map("end_date")
  startNumber      Int?      @map("start_number")
