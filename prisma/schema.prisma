  invoiceId        Int?      @map("invoice_id")
  prefix           String    @default("FC")
  consecutive      Int
  contingencyType  String    @default("04")
  reason           String?
  customerNit      String?   @map("customer_nit")
  customerName     String?   @map("customer_name")
  customerEmail    String?   @map("customer_email")
  customerPhone    String?   @map("customer_phone")
  customerAddress  String?   @map("customer_address")
  customerRegime   String?   @map("customer_regime")
  customerType     String?   @map("customer_type")
  subtotalBase     Int       @default(0) @map("subtotal_base")
  taxExemptAmount  Int       @default(0) @map("tax_exempt_amount")
  taxBreakdown     String?   @map("tax_breakdown")
  totalTaxAmount   Int       @default(0) @map("total_tax_amount")
  totalWithTax     Int       @map("total_with_tax")
