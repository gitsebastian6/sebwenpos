.
# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.next-snapshot/
/.turbo/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env
.env.local
.env.production
.env.development
.env.docker
!.env.example
!.env.docker.example

# vercel
.vercel


# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude
.z-ai-config
*.log
dev.log
dev.out.log
test
!src/test/
prompt

server.log

# Skills directory
/skills/

# Generated artifacts — not source code
/download/
/agent-ctx/
worklog.md
.git-commit.log

# File uploads (receipts, etc.)
/uploads/

# Backup files from DB migrations
*.bak
*.backup.*

# Kilo CLI (agent tooling + node_modules) — not source code
/.kilo/

# Auto-push protection active
mini-services/ai-chat-service/log.txt

# Local DB backups and Windows reserved-name artifact — never commit
/backups/
/nul

# SQLite databases — dev-only, never commit (prod runs Postgres)
*.db
*.db-journal
*.db-wal
*.sqlite
*.sqlite3

# Local tooling scratch output
/tsc_out.txt
/c:Users*
